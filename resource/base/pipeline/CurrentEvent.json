{
    // ============================================================
    // CurrentEvent.json
    // 功能：活动关卡扫荡（主线「胜负一线」+ 复刻「升腾」）
    // 入口节点：#当期活动
    //
    // 2026-11-24 换期改版：
    //   ① 主线活动换成「胜负一线 FINELINE」：
    //      主界面右侧卡片「胜负一线」→ 活动主页右下「首弯争锋」→ 关卡地图 FL105。
    //   ② 复刻活动「升腾 ASCENSION」入口改到**主界面左侧「复刻活动」**按钮：
    //      左侧「复刻活动」→ 复刻活动页（若为列表则选「升腾」）→ 升腾主页
    //      → 底部「升腾仪式」→ 关卡地图 AE201（心锚行动力）。
    //      旧版是从主界面右侧活动 banner 直进活动主页，该路径已废弃。
    //   ③ 两条链共用 `选择关卡` 节点，由 interface 的 option case override
    //      切换入口 next 与关卡 OCR expected（FL105 / AE201）。
    //
    // 关卡编号定位一律用 OCR（编号是纯白小字）+ 点击识别框中心；
    // 关卡地图会记忆相机位置，坐标不写死，找不到时左右平移兜底。
    // 基准分辨率：1280×720
    // ============================================================

    // ---------- 任务入口 ----------
    "#当期活动": {
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 任务开始",
            "Node.PipelineNode.Completed": "当期活动 · 完成",
            "Node.PipelineNode.Failed": "当期活动 · 失败"
        },
        "next": ["当期活动"]
    },


    // ---------- 逻辑入口：默认走主线胜负一线；AE201 case 由 override 换成复刻活动 ----------
    "当期活动": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 正在定位活动入口"
        },
        "next": [
            // 活动已结束（主界面没有对应卡片）→ 直接收尾，不要等 30s 超时报失败。
            "当前无活动",
            "进入胜负一线",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_NavigateHomepage"
        ]
    },


    // ---------- 步骤 0：判断活动是否开放 ----------
    // 主界面判定 + post_delay：从关卡地图页回主界面后，右侧/左侧活动卡片的文字
    // 渲染比模板图标慢（2026-11-24 实测：不等待时 OCR 两处同时失配，整条 next 直接失败），
    // 这里强制等 2s 再做 OCR 判定。
    "当前无活动": {
        "timeout": 8000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 检查活动是否开放"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [32, 562, 137, 145],
                "template": "Homepage/SystemButton.png",
                "threshold": 0.8
            }
        },
        "post_delay": 2000,
        "next": [
            "主线无卡片",
            "进入胜负一线"
        ]
    },

    // 主界面右侧「胜负一线」卡片不存在 ⇒ 主线活动已结束。
    // inverse：识别不到才命中 → 收尾。AE201 case 由 override 把整支换成 `复刻无卡片`。
    "主线无卡片": {
        "timeout": 8000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 主线未开放，跳过"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [990, 230, 290, 150],
                "expected": ["胜负一线"]
            }
        },
        "inverse": true,
        "next": ["_StopTask"]
    },

    // 主界面左侧「复刻活动」按钮不存在 ⇒ 复刻活动已结束（仅 AE201 case 走到）。
    "复刻无卡片": {
        "timeout": 8000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 复刻未开放，跳过"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 180, 260, 150],
                "expected": ["复刻活动"]
            }
        },
        "inverse": true,
        "next": ["_StopTask"]
    },


    // ---------- 步骤 1（主线）：主界面右侧卡片「胜负一线」 ----------
    // 卡片标题文字触发，点文字中心即落在卡片内。
    "进入胜负一线": {
        "timeout": 20000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 正在进入「胜负一线」"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [990, 230, 290, 150],
                "expected": ["胜负一线"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["关闭活动提示", "进入首弯争锋"]
    },

    // ---------- 步骤 2（主线）：活动主页右下「首弯争锋」 ----------
    // ROI 限定右下按钮区：关卡地图左上也有「首弯争锋」标题，避免在地图页重复点击。
    "进入首弯争锋": {
        "timeout": 20000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 正在进入「首弯争锋」"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [900, 460, 380, 120],
                "expected": ["首弯争锋"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["首弯未开启", "选择关卡", "_关卡地图平移1"]
    },

    // 「首弯争锋」未到开启时间时按钮下方有「2026.11.25 18:00 开启」，
    // 点进去也只会停在活动主页 → 识别到「开启」即视为本期无法扫荡，成功收尾。
    "首弯未开启": {
        "timeout": 5000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 首弯争锋尚未开启，跳过"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [900, 580, 380, 110],
                "expected": ["开启"]
            }
        },
        "next": ["_StopTask"]
    },


    // ---------- 步骤 1（复刻）：主界面左侧「复刻活动」 ----------
    // 图2 实机位置：左侧竖排按钮，在「应对协议」下方（约 y≈250，带「剩余14天」角标）。
    "进入复刻活动": {
        "timeout": 20000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 正在进入「复刻活动」"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 180, 260, 150],
                "expected": ["复刻活动"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["关闭活动提示", "进入升腾仪式", "选择复刻活动升腾"]
    },

    // 若「复刻活动」进去是复刻活动列表（不是直接到升腾主页），点「升腾」卡片。
    // 顺序放在 `进入升腾仪式` 之后：已在升腾主页时底部按钮先命中，不会误点右侧大标题。
    "选择复刻活动升腾": {
        "timeout": 15000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 正在选择「升腾」"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 120, 1280, 560],
                "expected": ["升腾"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["进入升腾仪式"]
    },

    // ---------- 步骤 2（复刻）：升腾主页底部右侧「升腾仪式」 ----------
    // 「升腾仪式」是艺术描边字 + 星形图标，OCR 实测整块读不出（ROI 内 all_results 为空），
    // 只能走模板匹配。模板 2026-11-24 从实机活动主页裁出（240×108，含图标与文字）。
    // ROI 只给按钮周边，避免关卡地图页左上标题误命中。
    "进入升腾仪式": {
        "timeout": 20000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 正在进入「升腾仪式」"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [930, 520, 350, 200],
                "template": "当期活动/升腾仪式.png",
                "threshold": 0.8
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["选择关卡", "_关卡地图平移1"]
    },


    // ---------- 每日一次的金色提示弹窗（进活动主页时弹） ----------
    // 不关掉会遮住右侧/底部入口。识别放宽到关键字，命中后点金色 ✓。
    "关闭活动提示": {
        "timeout": 3000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [400, 180, 520, 180],
                "expected": ["今日获得", "硬币", "注意"]
            }
        },
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 关闭每日活动提示弹窗"
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 380, 1, 1]
            }
        },
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        // 三个活动主页互斥：命中的只有一个（胜负一线页无升腾/探索入口，反之亦然）。
        // 探索之旅 case 由 interface override 把本节点 next 收敛为 ["进入探索之旅"]，
        // 否则升腾主页会先命中「进入升腾仪式」模板，静默走错链。
        "next": ["进入首弯争锋", "进入升腾仪式", "进入探索之旅"]
    },


    // ---------- 步骤 3：OCR 选择关卡并点击 ----------
    // 关卡标签（FL105 / AE201）是纯白小字，OCR 直接读编号 → 点识别框中心。
    // roi 限制在地图主体区，避开左上章节标题与底部「剧情/掉落」按钮。
    // 默认 FL105（胜负一线）；AE201 case 由 interface override 换 expected。
    "选择关卡": {
        "timeout": 60000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 定位并点击目标关卡"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                // 全屏 ROI：MaaFW OCR 对宽=全屏的"地图主体" ROI 会缩放送 det 模型，
                // 15px 高的关卡编号会丢（2026-11-24 实测同 ROI 全屏能读 0.99、裁剪区读不到）。
                "roi": [0, 0, 1280, 720],
                "expected": ["FL105"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["点击快速完成"]
    },

    // 复刻·升腾仪式专用选关节点（AE201 case 由 interface override 把平移链与
    // `进入升腾仪式.next` 指到这里）。
    // ⚠️ 不用 override 替换 `选择关卡.recognition`：2026-11-24 实测 MaaFW 的
    //    pipeline_override 深合并下该替换不可靠（节点识别类型疑似未变，扫满窗口失败）。
    // AE201 是金色艺术字 + 暗背景，全屏 OCR 检测不稳定（同画面时中时不中），
    // 改用绿幕模板（金色字形保留、背景置纯绿 + green_mask），实测自身 1.0、
    // 相邻 AE202S 处 0.57，区分度足够。
    "选择升腾关卡": {
        "timeout": 60000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 定位并点击「AE201」"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [0, 0, 1280, 720],
                "template": "当期活动/升腾AE201.png",
                "green_mask": true,
                "threshold": 0.8
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["点击快速完成"]
    },

    // 复刻·探索之旅入口（AE110/111/112 case 由 interface override 接入）。
    // 探索之旅按钮在升腾主页底部左侧（升腾仪式在右侧），OCR roi 只罩左半，
    // 避免与 `进入升腾仪式` 的模板 roi 交叠。
    "进入探索之旅": {
        "timeout": 20000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 正在进入「探索之旅」"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [740, 620, 260, 80],
                "expected": ["探索之旅"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["选择探索关卡", "_关卡地图平移1"]
    },

    // 探索之旅选关：认 AE111 锚点（该区域无动态光柱，匹配稳定），再按相对偏移
    // 点击目标关卡。AE 是艺术描边字 OCR 读不出，沿用 2026-11-13 验证过的锚点方案。
    // 偏移量（相对锚点识别框左上角）：AE110 (+159,-94)、AE111 (0,0)、AE112 (-200,-94)，
    // AE110/AE112 由 interface case override target_offset。
    "选择探索关卡": {
        "timeout": 60000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 定位并点击目标关卡（探索之旅）"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [0, 150, 1280, 480],
                "template": "当期活动/升腾AE111.png",
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [0, 0, 0, 0]
            }
        },
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["点击快速完成"]
    },


    // ---------- 步骤 3b：平移兜底（目标关卡被相机推出可视区） ----------
    // 门控：关卡地图左上章节标题或底部「掉落」（固定 UI），防盲滑。
    // 2026-11-24 实测：FL105 在整条赛道最右端，进入时相机记忆位置不同会把它推出视野。
    //   ⚠️ 拖动有惯性：动作后必须等画面冻结（post_wait_freezes 2500）再识别，
    //      只等 1.2s 时 OCR 抓到的是滑动中的糊帧，必然失配。
    //   链式限次：左拖 ×2 → 右拖 ×1，每步后都回 `选择关卡` 重试。
    "_关卡地图平移1": {
        "timeout": 20000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 55, 420, 200],
                "expected": ["首弯争锋", "升腾仪式", "探索之旅", "掉落"]
            }
        },
        // MaaFW Swipe（minitouch）对关卡地图拖动无效（画面不动），改走 agent 的
        // adb `input swipe`（见 agent/my_action.py「地图拖动」）。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "地图拖动",
                "begin": [1150, 400],
                "end": [480, 400],
                "duration": 600
            }
        },
        // 地图背景有常驻动画（旗帜/云），threshold 0.9 永远判不到"冻结"会拖满 timeout；
        // 惯性收尾已由「地图拖动」动作内的 settle 1.8s 覆盖，这里 0.85+1.5s 只是兜底。
        "post_wait_freezes": {
            "time": 1500,
            "threshold": 0.85
        },
        "next": ["选择关卡", "_关卡地图平移2"]
    },

    "_关卡地图平移2": {
        "timeout": 20000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 55, 420, 200],
                "expected": ["首弯争锋", "升腾仪式", "探索之旅", "掉落"]
            }
        },
        // MaaFW Swipe（minitouch）对关卡地图拖动无效（画面不动），改走 agent 的
        // adb `input swipe`（见 agent/my_action.py「地图拖动」）。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "地图拖动",
                "begin": [1150, 400],
                "end": [480, 400],
                "duration": 600
            }
        },
        // 地图背景有常驻动画（旗帜/云），threshold 0.9 永远判不到"冻结"会拖满 timeout；
        // 惯性收尾已由「地图拖动」动作内的 settle 1.8s 覆盖，这里 0.85+1.5s 只是兜底。
        "post_wait_freezes": {
            "time": 1500,
            "threshold": 0.85
        },
        "next": ["选择关卡", "_关卡地图平移3"]
    },

    "_关卡地图平移3": {
        "timeout": 20000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 55, 420, 200],
                "expected": ["首弯争锋", "升腾仪式", "探索之旅", "掉落"]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "地图拖动",
                "begin": [480, 400],
                "end": [1150, 400],
                "duration": 600
            }
        },
        // 地图背景有常驻动画（旗帜/云），threshold 0.9 永远判不到"冻结"会拖满 timeout；
        // 惯性收尾已由「地图拖动」动作内的 settle 1.8s 覆盖，这里 0.85+1.5s 只是兜底。
        "post_wait_freezes": {
            "time": 1500,
            "threshold": 0.85
        },
        "next": ["选择关卡"]
    }
}
