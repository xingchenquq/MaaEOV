{
    // ============================================================
    // CurrentEvent.json
    // 功能：当期活动
    // 入口节点：#当期活动
    // 说明：自动扫荡当期活动关卡（长夜尽头的旅人 · 在光消失的地方）。
    //
    // 2026-10-22 重写（v1.1.1501「长夜尽头的旅人」）：
    //   旧版是「临界视域-危险地带」，需先点活动主页的「危险地带」入口再选 CS110/111/112。
    //   新版活动没有「危险地带」：活动主页右侧直接是「在光消失的地方」章节入口，
    //   点进入即关卡地图，关卡为 WN 系列（WN108/109/110，已三星可扫荡）。
    //   → 选关改用 **OCR 识别关卡编号**（实测 WN108/109/110 命中 0.95~0.99），
    //     不再用绿幕末位字形模板（该方案对 CS 系列是不得已，WN 系列 OCR 足够稳且省维护）。
    //   → 扫荡链完全复用 Shared.json 的「点击快速完成」→ 行动力判定 → 行动次数确定 → 出发 → 结算。
    //
    // 关卡地图会记忆相机位置（旧活动实测平移 ~250px），因此**关卡坐标不可写死**，
    //   一律用 OCR 全图搜索 + 点击识别框中心；找不到时走平移兜底。
    // 基准分辨率：1280×720
    // ============================================================

    // ---------- 任务入口 ----------
    "#当期活动": {
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 任务开始",
            "Node.PipelineNode.Completed": "当期活动 · 完成",
            "Node.PipelineNode.Failed": "当期活动 · 失败"
        },
        "next": ["当期活动"]
    },


    // ---------- 逻辑入口：先回主界面（若不在），再进活动 ----------
    "当期活动": {
        "timeout": 30000,
        "next": [
            // 活动已结束（主界面没有「剩余X天」banner）→ 直接收尾，不要等 30s 超时报失败。
            "当前无活动",
            "进入活动页",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_NavigateHomepage"
        ]
    },


    // ---------- 步骤 1：点主界面活动 banner 进入活动 ----------
    // 主界面右上角 banner，OCR「剩余X天」同时承担活动过期判定。
    // 2026-10-22 实测：新版本 banner 位置未变，本节点无需改动
    //   （「长夜尽头的旅人 · 剩余19天」命中 score 0.9994，box≈(1171,360,76,21)）。
    // 主界面 + 无活动 banner ⇒ 本期活动已结束（2026-11-02 修：旧实现会 30s 超时 → 任务 FAIL，
    // 与 interface doc 里写的「活动结束后自动跳过」不符）。
    "当前无活动": {
        "timeout": 8000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 检查活动是否开放"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    32,
                    562,
                    137,
                    145
                ],
                "template": "Homepage/SystemButton.png",
                "threshold": 0.8
            }
        },
        "next": [
            "当前无活动确认",
            "进入活动页"
        ]
    },

    "当前无活动确认": {
        "timeout": 8000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 未开放，跳过"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1150,
                    355,
                    130,
                    50
                ],
                "expected": [
                    "剩余"
                ]
            }
        },
        "inverse": true,
        "next": [
            "_StopTask"
        ]
    },

    "进入活动页": {
        "timeout": 30000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1150, 355, 130, 50],
                "expected": ["剩余"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1500,
            "threshold": 0.85
        },
        "next": ["关闭活动提示", "进入关卡章节", "进入探索之旅"]
    },


    // ---------- 步骤 2a：关掉「注意 今日获得30枚硬币」金色弹窗 ----------
    // ⚠️ 这个弹窗是**每日一次**（每天第一次进活动时弹），所以必须在任务里自动关掉，
    //    否则当天第一次跑任务会被它遮住右侧章节入口，一直卡到超时。
    // 识别放宽到「硬币」等关键字（弹窗文案可能微调），命中后点金色 ✓ (640,380) 关闭。
    // timeout 写小：没弹窗时快速放行到「进入关卡章节」。
    "关闭活动提示": {
        "timeout": 3000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [400, 180, 520, 180],
                "expected": ["今日获得", "硬币", "注意"]
            }
        },
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 关闭每日活动提示弹窗"
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 380, 1, 1]
            }
        },
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": ["进入关卡章节", "进入探索之旅"]
    },


    // ---------- 步骤 2c：复刻活动的章节入口在**底部**（升腾：探索之旅 / 升腾仪式）----------
    // 与「在光消失的地方」那种右侧竖排章节不同，所以单开一个节点，两个入口并列尝试：
    // 老形态（长夜）走「进入关卡章节」，复刻形态（升腾）走这里。
    // 2026-11-13 实测升腾活动主页：「探索之旅」在底部左（约 776~948, 640~687），
    // 「升腾仪式」在右；只点前者，仪式是独立玩法不在本任务范围。
    "进入探索之旅": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 正在进入「探索之旅」"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [740, 620, 260, 80],
                "expected": ["探索之旅"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["选择关卡", "_关卡地图平移1"]
    },


    // ---------- 步骤 2b：活动主页右侧点「在光消失的地方」章节 ----------
    // 活动主页右侧竖排：活动成就 / 时限特性 / 在光消失的地方（章节入口，带开启时间）。
    // 用 OCR 定位而不是写死坐标，避免 UI 微调后失效。
    "进入关卡章节": {
        "timeout": 60000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 正在进入「在光消失的地方」章节"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [950, 460, 330, 90],
                "expected": ["在光消失的地方", "消失的地方"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 2000,
            "threshold": 0.85
        },
        "next": ["选择关卡", "_关卡地图平移1"]
    },


    // ---------- 步骤 3：OCR 选择关卡并点击 ----------
    // 关卡徽章下方有「WNxxx」标签，OCR 直接读编号 → 点识别框中心即选中该关。
    // roi 限制在地图主体区，避开左上章节标题与底部「剧情/掉落」按钮。
    // option「当期活动-选择关卡」按 case 覆盖 expected（WN108 / WN109 / WN110）。
    "选择关卡": {
        "timeout": 60000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 定位并点击目标关卡"
        },
        // 只识别 AE111 当锚点（该区域无动态光柱，匹配稳定），再按相对偏移点击目标关卡。
        // 为什么不用每关一个模板：6 个关卡的图标完全相同、编号仅差末位（11x），
        // 模板会串关；AE110/AE112 位置还有动态光柱，分数掉到 0.83 并误命中 AE101。
        // OCR 也不行：WN 系列能读 0.95+，AE 是艺术描边字，连「AE」都读不出。
        // 偏移量（相对识别框左上角）：AE110 (+159,-94)、AE111 (0,0)、AE112 (-200,-94)。
        // 2026-11-13 21:45 实机逐关验证通过：AE110→「痛苦的回响」、AE111→「此路不通」、
        // AE112→「升腾仪式」（首领）。地图相机位置每次进入都不同（AE110 曾出现在右下也出现在左上），
        // 但相对偏移随之平移，所以锚点方案不受影响。
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [0, 150, 1280, 480],
                "template": "当期活动/升腾AE111.png",
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [0, 0, 0, 0]
            }
        },
        "post_wait_freezes": {
            "time": 2500,
            "threshold": 0.85
        },
        "next": ["点击快速完成"]
    },


    // ---------- 步骤 3b：平移兜底（目标关卡被相机推出可视区） ----------
    // 门控：OCR 左上角章节标题「在光消失的地方」（屏幕固定 UI），防盲滑。
    // 动作：平移1 左拖（露出右侧 AE110~112）、平移2 右拖（露出左侧 AE101~103），双向兜底；
    // 有界：平移1 → 再 OCR → 平移2 → 再 OCR（各 30s 窗口），仍不中则明确失败。
    "_关卡地图平移1": {
        "timeout": 60000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 55, 420, 90],
                "expected": ["在光消失的地方", "消失的地方", "探索之旅"]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [1120, 400, 1, 1],
                "end": [640, 400, 1, 1],
                "duration": 500,
                "end_hold": 200
            }
        },
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": ["选择关卡", "_关卡地图平移2"]
    },

    "_关卡地图平移2": {
        "timeout": 30000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 55, 420, 90],
                "expected": ["在光消失的地方", "消失的地方", "探索之旅"]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [640, 400, 1, 1],
                "end": [1120, 400, 1, 1],
                "duration": 500,
                "end_hold": 200
            }
        },
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": ["选择关卡"]
    }
}
