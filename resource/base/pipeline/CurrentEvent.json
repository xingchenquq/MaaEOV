{
    // ============================================================
    // CurrentEvent.json
    // 功能：当期活动
    // 入口节点：#当期活动
    // 说明：自动扫荡当期活动（临界视域）危险地带关卡。
    // 由 scripts/split_pipeline.py 从 Tasks.json 拆分生成；请勿跨文件重复定义同名节点。
    // 本文件节点数 = 7
    // 依赖 Shared.json 节点数 = 4（示例：_ConfrimReconnect, _NavigateHomepage, _ServerMaintenance, 点击快速完成）
    // ============================================================

    // ---------- 任务入口：#当期活动（当期活动） ----------

    // ============================================================
    // 当期活动（临界视域 Critical Sight · 2026-09-30 ~ 2026-10-14，剩余8天）
    // 目标：进入活动 → 活动主页点「危险地带」→ 关卡地图模板匹配选关 → 循环战斗 → 体力/次数耗尽停
    // 基准分辨率：1280×720
    // 截图来源：MuMu-20261005-122308-013(主界面) / 122312-932(活动主页) / 122317-627(关卡地图)
    //          实机失败件 debug/on_error/2026.10.05-17.09.22.694_选择危险地带.png（相机位移场景）
    // ============================================================

    // ---------- 任务入口 ----------
    "#当期活动": {
        "next": ["当期活动"]
    },


    // ---------- 逻辑入口：开始时先返回主界面（若不在主界面），再进入活动 ----------
    // 仿照 DailyStaminaBonus 等任务：先尝试直接走流程，若当前不在主界面，
    // 则依次处理服务器维护 / 重连弹窗，最后 [JumpBack]_NavigateHomepage 回主界面。
    "当期活动": {
        "timeout": 30000,
        "next": [
            "进入活动页",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfrimReconnect",
            "[JumpBack]_NavigateHomepage"
        ]
    },


    // ---------- 步骤 1：点主界面右上角活动 banner 进入活动 ----------
    // 截图：MuMu-20261005-122308-013.png (1280×720)
    // 临界视域 banner 整体约 [1040, 270, 238, 140]；OCR 找"剩余"用 ROI [1045, 212, 235, 194]
    // 「剩余8天」实测位于约 [1177, 364, 55, 15]，落在 ROI 内；命中后 Click 落在 banner 卡片上，自然点中。
    // 实机已验证：17:07 运行成功进入活动主页。
    // 注：OCR「剩余X天」同时承担活动过期判定——活动结束后 OCR 无匹配则任务超时跳过；
    //     下期活动 banner 位置/样式若变需重新截图定 ROI。
    "进入活动页": {
        "timeout": 30000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1045, 212, 235, 194],
                "expected": ["剩余"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": ["选择危险地带"]
    },


    // ---------- 步骤 2：活动主页点「危险地带」进入关卡地图 ----------
    // 截图：MuMu-20261005-122312-932.png (1280×720)
    // 活动主页右侧三个玩法入口：危险地带1 / 变节探员2 / 大战应援层3；
    // 「DANGER ZONE 危险地带1」艺术字模板裁自 [735, 382, 290, 110]（含底部阴影条）。
    // 阈值 0.9：入口模板在关卡地图上的误检峰值仅 0.34，余量充足。
    // 实机已验证：17:08 成功匹配并点击进入关卡地图。
    // 匹配失败（活动主页改版/入口样式变化）→ 本节点超时 → 任务报错，不会误点其他玩法入口。
    "选择危险地带": {
        "timeout": 60000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 正在进入「危险地带」关卡地图"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [0, 0, 1280, 720],
                "template": "当期活动/危险地带.png",
                "threshold": 0.9
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1500,
            "threshold": 0.85
        },
        "next": ["选择危险地带关卡", "_危险地带平移1"]
    },


    // ---------- 步骤 3：关卡地图模板匹配选关并点击 ----------
    // ⚠️ 2026-10-05 17:07 实机教训：游戏会记忆地图相机位置（本次整体左移 ~250px），
    //    徽章边角带入的背景像素随相机错位，整徽章模板得分从 1.0 掉到 0.8725（阈值 0.92）→ 全部滤掉 → 超时。
    // 修复：模板改「绿幕掩膜」——仅保留关卡代号数字带（更精确到末位字形 0/1/2，
    //    这是三个徽章唯一不同的像素区域），加 "green_mask": true 后匹配与背景/相机位置完全解耦。
    // 离线双场景验证（源图 + 实机失败件）：
    //   自身命中 0.9975~1.0；对其他徽章/全图误匹配峰值 ≤ 0.754 → 阈值 0.87 两侧余量均 > 0.11。
    // 模板构成：徽章框内末位字形矩形（含少量数字带底色），其余像素纯绿 (0,255,0)：
    //   CS110 [238,305,107,120] 局部 (58,80,78,104) / CS111 [595,470,95,130] 局部 (58,97,72,118)
    //   CS112 [940,305,110,120] 局部 (64,82,84,104)
    // 默认匹配 CS110，由 interface.json "危险地带-选择关卡" 选项按 case 覆盖 template。
    //
    // 失败/降级处理：
    //   - 若目标徽章被屏幕边缘裁掉（相机位置所致），模板无法命中 → 走 next 的平移兜底（见下）；
    //   - 平移 2 次后仍不中 → _危险地带平移2 的 next 扫描超时 → 任务以 "Task timeout" 明确失败，
    //     留存 debug/on_error 截图；不做 OCR 兜底点击（误点相邻关卡会白耗行动力）；
    //   - 后续活动新增 CS113+ 时：截图裁新末位字形绿幕模板 + interface.json 增加 case 即可。
    "选择危险地带关卡": {
        "timeout": 120000,
        "focus": {
            "Node.PipelineNode.Starting": "当期活动 · 模板匹配选择危险地带关卡"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [0, 0, 1280, 720],
                "template": "当期活动/危险地带_CS110.png",
                "threshold": 0.87,
                "green_mask": true
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 3000,
            "threshold": 0.85
        },
        "next": ["点击快速完成"]
    },


    // ---------- 步骤 3b：平移兜底（相机位置导致关卡被屏幕边缘裁掉时） ----------
    // 门控：用左上角「危险地带」标题模板（裁自实机失败件 [88,92,124,41]，屏幕固定 UI）确认当前在关卡地图，
    //   防止地图未加载完/误入其他界面时盲滑。标题模板在两张地图截图上 0.97/1.0，
    //   活动主页/主界面误检 ≤ 0.375，门控阈值 0.85。
    // 动作：手指从 (420,400) 右拖至 (1060,400)（内容右移，露出被左缘裁掉的关卡），
    //   duration 500ms + end_hold 200ms 抑制惯性。
    // 有界重试：平移1 → 再匹配 → 平移2 → 再匹配（30s 窗口）→ 仍不中则任务明确失败。
    "_危险地带平移1": {
        "timeout": 120000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [0, 0, 640, 240],
                "template": "当期活动/危险地带_地图标题.png",
                "threshold": 0.85
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [420, 400, 1, 1],
                "end": [1060, 400, 1, 1],
                "duration": 500,
                "end_hold": 200
            }
        },
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": ["选择危险地带关卡", "_危险地带平移2"]
    },
    "_危险地带平移2": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [0, 0, 640, 240],
                "template": "当期活动/危险地带_地图标题.png",
                "threshold": 0.85
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [420, 400, 1, 1],
                "end": [1060, 400, 1, 1],
                "duration": 500,
                "end_hold": 200
            }
        },
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": ["选择危险地带关卡"]
    }
}
