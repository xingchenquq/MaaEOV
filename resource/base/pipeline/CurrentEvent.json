{
    // ============================================================
    // CurrentEvent.json
    // 功能：当期活动
    // 入口节点：#当期活动
    // 说明：自动扫荡当期活动关卡。
    // 由 scripts/split_pipeline.py 从 Tasks.json 拆分生成；请勿跨文件重复定义同名节点。
    // 本文件节点数 = 5
    // 依赖 Shared.json 节点数 = 4（示例：_ConfrimReconnect, _NavigateHomepage, _ServerMaintenance, 点击快速完成）
    // ============================================================

    // ---------- 任务入口：#当期活动（当期活动） ----------

    // ============================================================
    // 当期活动（银湖之畔 · 2026-09-10，剩余4天）
    // 目标：进入活动 → 选关卡 → 循环战斗 → 体力/次数耗尽停
    // 基准分辨率：1280×720
    // ============================================================

    // ---------- 任务入口 ----------
    "#当期活动": {
        "next": ["当期活动"]
    },


    // ---------- 逻辑入口：开始时先返回主界面（若不在主界面），再进入活动 ----------
    // 仿照 DailyStaminaBonus 等任务：先尝试直接走流程，若当前不在主界面，
    // 则依次处理服务器维护 / 重连弹窗，最后 [JumpBack]_NavigateHomepage 回主界面。
    "当期活动": {
        "next": [
            "进入活动页",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfrimReconnect",
            "[JumpBack]_NavigateHomepage"
        ]
    },


    // ---------- 步骤 1：点主界面右上角活动 banner 进入活动 ----------
    // 截图：assets/resource/image/当期活动/主界面.png (1280×720)
    // banner 整体 [959, 152, 251, 251]；OCR 找"剩余"用 ROI [1045, 212, 240, 194]
    // 命中后 Click 会落在 banner 内，自然点中。
    // 注：本坐标针对"银湖之畔"banner（"剩余X天"会在 banner 右侧中部）；
    //     下期活动 banner 位置/样式若变需重新定。
    "进入活动页": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1045, 212, 240, 194],
                "expected": ["剩余"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": ["选择关卡"]
    },


    // ---------- 步骤 2：选择关卡难度 ----------
    // 截图：assets/resource/image/当期活动/当期活动主界面.png
    // 当期活动（银湖之畔）：右侧两个关卡 —— 被诅咒的信仰 / 冰冷的救赎
    // ROI 包含整个右侧关卡列，约 [870, 350, 380, 230]
    // expected 默认"被诅咒的信仰"，由 interface.json "关卡难度" 选项覆盖
    // 注：本期活动有 2 个难度，某些活动会出 3 个难度，下次遇再修改选项。
    "选择关卡": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [870, 350, 380, 230],
                "expected": ["被诅咒的信仰"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1000,
            "threshold": 0.85
        },
        "next": ["选择小关卡"]
    },


    // ---------- 步骤 3：全界面识别关卡代号（SLxxx）并点击 ----------
    // 截图：assets/resource/image/当期活动/被诅咒的信仰.png
    // 进关卡详情页（被诅咒的信仰），本期可见 SL106/107/108/109/110
    // 全界面 OCR 找代号（不同活动节点位置不同，故不限 ROI）
    // 默认刷数字最大的一关 = SL110
    // TODO(打包 exe 时)：改成自动列出识别到的全部代号，做下拉栏让用户选
    "选择小关卡": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 0, 1280, 720],
                "expected": ["SL11[0O]"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 3000,
            "threshold": 0.85
        },
        "next": ["点击快速完成"]
    }
}
