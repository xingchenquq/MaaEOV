{
    // ============================================================
    // Mailbox.json
    // 功能：领取邮件
    // 入口节点：Mailbox（聚合入口见 Aggregated.json 的 #活动领取）
    // 说明：领取全部邮件。
    // 由 scripts/split_pipeline.py 从 Tasks.json 拆分生成；请勿跨文件重复定义同名节点。
    // 本文件节点数 = 6
    // 依赖 Shared.json 节点数 = 4（示例：_ConfirmMiddle, _ConfirmReconnect, _NavigateHomepage, _ServerMaintenance）
    // ============================================================

    // Mailbox
    "~Mailbox": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    55,
                    586,
                    229,
                    132
                ],
                "template": "Mailbox/CollectMail.png"
            }
        },
        "post_wait_freezes": 1000
    },

    // Mailbox =========================================
    // Navigate to Mailbox
    "_NavigateMailbox": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    55,
                    586,
                    229,
                    132
                ],
                "template": "Mailbox/CollectMail.png"
            }
        },
        "inverse": true,
        "next": [
            "~Mailbox",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_MailboxFromHome",
            "[JumpBack]_NavigateHomepage"
        ]
    },

    "_MailboxFromHome": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    331,
                    616,
                    62,
                    61
                ],
                "template": "Homepage/Mailbox.png"
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1000,
            "threshold": 0.8
        }
    },

    // ---------- 子链：领取邮件（由 Aggregated.json 的 #活动领取 经 _EventGateMail 调用） ----------
    // 转场说明：领完邮件不再直接指向下一环，而是指向下一环的 Gate（Aggregated.json），
    // 这样本环节被开关禁用时链路仍能继续（见 Aggregated.json 文件头「开关设计」）。

    // Mailbox =========================================
    // Logic
    "Mailbox": {
        "timeout": 30000,
        "next": [
            "_EventGateMail"
        ]
    },

    "CollectMail": {
        "focus": {
            "Node.PipelineNode.Starting": "活动领取 · 领取邮件"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    55,
                    586,
                    229,
                    132
                ],
                "template": "Mailbox/CollectMail.png"
            }
        },
        "action": "Click",
        "post_wait_freezes": 1000,
        // 聚合接力：本任务是「活动领取」的第一环，领完全部邮件后交给「每日行动补给」所在闸门。
        "next": [
            "_EventGateStamina"
        ]
    }
}
