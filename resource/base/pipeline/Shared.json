    // ---------- 步骤 4：在关卡详情界面点"快速完成" ----------
    // 截图：assets/resource/image/当期活动/关卡详情.png
    // 改为 OCR 识别「快速完成」后点击（原固定坐标 [910,670] 实测点不中/时机过早）
    // 点击后进入"快速完成"确认界面
    // next 放两个：先试"行动力判定"（有道具才命中），没命中就直奔"行动次数确定"
    // timeout 120000：当期/往期活动扫荡链链首，须覆盖下游「设置次数 → 点击出发 → 等待结果」整链（最长约 70s+），
    // 缺省 ~20s 会在等结算阶段被提前掐断 → 假阴性（同 v1.14.6 危机行动调令根因）。
    "点击快速完成": {
        "timeout": 120000,
        "focus": {
            "Node.PipelineNode.Starting": "扫荡 · 正在点击「快速完成」打开扫荡弹窗"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [700, 600, 400, 120],
                "expected": ["快速完成"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": ["行动力判定", "行动次数确定"]
    },


    // ============================================================
    // 快速完成界面流程（步骤 5~8）
    // 截图：assets/resource/image/当期活动/快速完成.png
    // ============================================================

    // ---------- 步骤 5a：行动力判定（可选节点） ----------
    // 在消耗品区 [454,189,608,165] 找"时"（如"1小时"道具）
    // 命中则点其【下方 70px】：target_offset [0,70,0,0]
    //   例：时 在 [512,209,5,4] → 点击 [512,279,5,4] 的中心 (514, 281)
    // 没命中 → 自动跳到 next 列表里的"行动次数确定"
    "行动力判定": {
        "timeout": 80000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [454, 189, 608, 165],
                "expected": ["时"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [0, 70, 0, 0]
            }
        },
        "post_wait_freezes": {
            "time": 800,
            "threshold": 0.85
        },
        "next": ["行动次数确定"]
    },


    // ---------- 步骤 5b：行动次数确定 ----------
    // 原生 _SweepMax 范式：先 OCR「快速完成次数」确认弹窗，再点滑块「最大」端 (955,457) 直达体力上限（左端 569=最小）
    "行动次数确定": {
        "timeout": 80000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [640, 365, 240, 40],
                "expected": ["快速完成次数"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [955, 457, 1, 1]
            }
        },
        "post_wait_freezes": {
            "time": 800,
            "threshold": 0.85
        },
        "next": ["点击出发"]
    },


    // ---------- 步骤 6：点"出发"执行快速完成 ----------
    // timeout 70000：父节点扫描 next 的窗口取自本节点，须覆盖下游「~等待快速完成结果」的 60s 等待。
    "点击出发": {
        "focus": {
            "Node.PipelineNode.Starting": "扫荡 · 已设置次数，点击「出发」开始扫荡"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [740, 480, 400, 165],
                "expected": ["出发"]
            }
        },
        "timeout": 70000,
        "action": "Click",
        "post_wait_freezes": {
            "time": 1500,
            "threshold": 0.85
        },
        "next": ["~等待快速完成结果"]
    },


    // ---------- 步骤 7a：等待结算界面出现 ----------
    // 全界面找结果页特征，最多等 60s（timeout 单位 ms）。
    // 注意：标题「快速完成结果」可能被角色立绘遮挡导致 OCR 残缺（实测只读出"快速"），
    // 故追加结果页独有锚点「完成次数」「认知度」（任一命中即可）。
    "~等待快速完成结果": {
        "focus": {
            "Node.PipelineNode.Starting": "扫荡 · 扫荡执行中，等待结算界面（最长 60 秒）"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 0, 1280, 720],
                "expected": ["快速完成结果", "完成次数", "认知度"]
            }
        },
        "timeout": 60000,
        "next": ["点击确定"]
    },


    // ---------- 步骤 7b：点"确定/确认退出"返回关卡详情界面 ----------
    // 右下角识别确认按钮。注意：不同活动/版本的结果屏按钮可能是"确定"或"确认退出"，
    // 两者都要认；否则若按钮是"确认退出"，OCR "确定"匹配不上且本节点无 timeout → 永久卡死。
    "点击确定": {
        "timeout": 30000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [940, 600, 340, 120],
                "expected": ["确定", "确认退出"]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": ["退出关卡详情页"]
    },


    // ---------- 步骤 8a：第一下 —— 退出关卡详情页 ----------
    // 点"确定"后回到关卡详情页，需先退出该详情页，回到上一层。
    // 左上角 [11,2,413,84] 内模板匹配 当期活动/主界面图标.png（36×30）
    "退出关卡详情页": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [11, 2, 413, 84],
                "template": "当期活动/主界面图标.png",
                "threshold": 0.85
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": ["返回主界面"]
    },


    // ---------- 步骤 8b：第二下 —— 真正返回主界面 ----------
    // 同位置（左上角同一区域）再点一次，从上一层返回主界面。
    // 若实测第二下匹配不到（界面左上角图标不同），把本节点改成
    // DirectHit + 固定坐标即可：{"recognition":"DirectHit","roi":[x,y,1,1]}
    "返回主界面": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [11, 2, 413, 84],
                "template": "当期活动/主界面图标.png",
                "threshold": 0.85
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "next": []
    },

    "无往日行动调令结束": {
        "recognition": "DirectHit",
        "roi": [
            0,
            0,
            1,
            1
        ],
        "next": []
    },

