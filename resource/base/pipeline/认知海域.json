{
    // ============================================================
    // 认知海域（Sea of Cognition）独立任务 pipeline（v0.2 多节点循环）
    // 基准分辨率：1280×720
    //
    // 玩法：双周本 · 自走棋式自动战斗。3 层递进：朦胧层→深潜层→梦渊层。
    //       只有「深潜指引」入口给意识碎片奖励（自由探索无奖励）。
    //       每 14 天刷新 7 张入场券；梦渊层单次 355 分，约 2 次跑满奖励。
    //
    // 真实流程（按用户提供截图 + 操作描述）：
    //   主界面 → 导航到 BCR → 点「认知海域」图标（层选择界面）
    //     → 点「梦渊层」节点选中 → 点右下「开始下潜」
    //     → 下潜方式二选一：优先「深潜指引」（给意识碎片）；当期已完成时右卡「暂不可用」→ 点「自由探索」
    //     → 配队界面点「进入海域」（不调队）→ 进入后展示梦渊层节点
    //     → 点「灵感节点」→ 【全局 Buff 选择，仅一次：往左滑看 Buff，选一个】
    //     → 进入战斗节点 → 【局内 Buff 选取：图中两个位置，点「激发」】
    //     → 点「开始战斗」→ 自动战斗（无需开 AUTO）
    //     → 结算（07_settle）点右下「继续」→ 下一节点（循环：局内 Buff→开始战斗→…）
    //     → 全部节点打完 → 领奖 → 循环下一轮（入场券耗尽即停）
    //
    // 战斗中达到积分会出现奖励弹窗（复用 _SeaOfCognitionReward 关闭）。
    //
    // 设计说明：
    // - 所有确定性按钮用 OCR 识别文字 + 自动点击匹配文字（无需精确坐标）。
    // - 两个图标用模板：SeaOfCognition/认知海域图标.png（选层界面底部入口）、SeaOfCognition/进入海域.png（配队界面进入按钮）。
    // - 导航复用 Tasks.json 共享节点：_NavigateBCR / _BCRHead / _BCRTail /
    //   _NavigateHomepage / _ServerMaintenance / _ConfirmReconnect /
    //   _ConfirmMiddle / _LevelUp / _CloseWindows / _SeaOfCognitionReward。
    //
    // ⚠️ 待用户实跑复核（坐标/模板已实现，首次跑建议盯一遍）：
    //   - 全局 Buff（仅一次，共 5 次选取）：同一固定界面，每期不变。
    //     优先级 能量涌流>战前准备>环境遮蔽>应急护盾>身心调和（模板均已就位）。
    //     按优先级逐个尝试，命中即点，点完回环 SoCGBLoop；每轮左滑前进一张。
    //     ⚠️ 选满判定：调试截图证实选中后卡片底部「未激发」文字**不消失**（仅加 ✓ 金边），
    //       故「模板不再匹配 / 卡片变暗」都不可靠；改用模板「剩余可选灵感0.png」(5 名额用完，取自 autodori)
    //       作为唯一可靠的选满信号（见 SoCGBAllDone）。「继续」按钮从进入就一直在，不能当信号。
    //   - 局内 Buff（每个战斗节点一次）：左卡[356,205,232,278]中心≈[472,344]、
    //     右卡[682,207,233,274]中心≈[798,344]；「激发」在[682,207,233,274]。
    //     当前流程：识别「激发」→点左卡→点右卡→点「激发」确认（即盲点两卡=「随机点左右」）。
    //     若游戏实为「二选一」只需点一张，告知我，我改成随机点单张。
    //   - 入场券耗尽弹窗文字（当前用「入场券不足」/「入场券数量不足」）。
    // ============================================================

    // ---------- 任务入口 ----------
    "#SeaOfCognition": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "认知海域 · 任务开始",
            "Node.PipelineNode.Completed": "认知海域（开发中） · 完成",
            "Node.PipelineNode.Failed": "认知海域（开发中） · 失败"
        },
        "next": [
            "SoCResume",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_NavigateBCR"
        ]
    },

    // ---------- 任务入口：检测当前流程位置（支持从任意中途界面续跑） ----------
    // DirectHit 路由节点：依次检查各中途状态，第一个匹配即续跑；都不匹配 → SoCFallbackStart 从 BCR 开始。
    // 顺序（由流程下游到上游）：领奖 → 结算(继续) → 开始作战 → 局内 Buff → 全局 Buff → 默认从头。
    // ⚠️ 各候选节点自身带识别+动作，命中后会直接执行该步（如点继续/点开始作战/点左卡）并沿原流程继续，
    //   因此「检测」同时也是「续跑」——无需额外跳转。
    "SoCResume": {
        "timeout": 930000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 0／检测当前流程位置"
        },
        "recognition": "DirectHit",
        "post_delay": 300,
        "next": [
            "_SoCAbandonDive",
            "_SoCScoreFull",
            "SoCClaim",
            "SoCContinue",
            "SoCStartBattle",
            "SoCInBattleBuff",
            "SoCInBattleBuffOCR",
            "SoCInspirationNode",
            "SoCInspirationNodeOCR",
            "SoCState_GB1",
            "SoCState_GB0",
            "_SoCTicketLow",
            "SoCStartDive",
            "SoCContinueDive",
            "SoCTicketGateFree",
            "SoCDeepDive",
            "SoCDeepDiveFree",
            "SoCFallbackStart",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_NavigateBCR"
        ]
    },

    // ---------- 券不足 → 引导走自由探索（不耗券） ----------
    // ⚠️ 2026-11-10 新增，让「券不足」任务有自然终态：
    //   旧行为：券 <2 且补不满 1000 分 → _SoCTicketLow 直接收工，免费模式也没得打；
    //           或被 override 硬放行 → 无限循环打下去，只能靠测试超时停。
    //   新状态机（agent/_FREE_ROUND）：券不足 → SoCTicketLow 放行并占位 →
    //     本节点命中（跳过深潜指引，防烧券/防「入场券不足」弹窗）→ 走自由探索 →
    //     选卡置 picked → 探索打完回选层 → SoCTicketLow 收工 → _SoCReturnHome。
    //   探索打完回选层后本节点必须排在 _SoCTicketLow **之后**被扫描（收工优先于再开一轮）。
    //   本节点 next **不含** SoCDeepDive / SoCDeepDiveFallback —— 引导后绝不回头点深潜。
    "SoCTicketGateFree": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "券不足 → 走自由探索（不耗券）"
        },
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SoCTicketFreeGate"
            }
        },
        "action": "DoNothing",
        "post_delay": 300,
        "next": [
            "SoCDeepDiveFree",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp"
        ]
    },

    // ---------- 发现进行中的下潜 → 放弃，重新开始 ----------
    // 实机 2026-11-01 04:19 确认的界面：选层界面右下角在「有进行中的海域」时会变成
    //   「终止下潜」+「继续下潜」两个按钮（正常状态下只有单个「开始下潜」），
    //   下方还有「探索进度 N/14」。
    // 设计决策：**不做续跑，直接放弃重开**。理由——
    //   ① 续跑时局内状态（已选 Buff、已打的节点、剩余灵感）我们无记忆，接上去大概率错乱；
    //   ② 放弃重开的代价只是这一轮的进度，而单轮仅 8~19 分钟，重开比"接错"便宜得多；
    //   ③ 这条链天然把「上次任务中途失败留下的烂摊子」清干净，每次从确定状态开始。
    // 放弃三步：终止下潜 → 确认「是否放弃本次探索」→ 「探索终止」结算屏 →点掉 → 回选层重开。
    "_SoCAbandonDive": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 0／发现进行中的下潜 → 放弃并重新开始"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [790, 610, 240, 70],
                "expected": ["[终終][止比]下[潜潛]"],
                "threshold": 0.8
            }
        },
        "action": "Click",
        "post_delay": 1500,
        "next": ["_SoCAbandonConfirm"]
    },

    // 确认框「注意 · 是否放弃本次探索」：✓ 确认放弃（✕ 是取消）
    "_SoCAbandonConfirm": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 0b／确认放弃本次探索"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [200, 250, 880, 120],
                "expected": ["放弃本次探索", "是否放弃"],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [732, 407, 1, 1]
            }
        },
        "post_delay": 2000,
        "next": ["_SoCAbandonResult"]
    },

    // 「探索终止」结算屏（标题「探索终止」+「完成节点 0/14」）→ 点屏幕任意处继续
    "_SoCAbandonResult": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 0c／探索终止结算 → 继续"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 0, 1280, 720],
                "expected": ["探索[终終]止", "完成节点", "完成節點"],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 360, 1, 1]
            }
        },
        "post_delay": 2000,
        // 放弃后回到选层界面（此时未选中层、两个按钮都消失）：
        // 先判满分（已满则收尾回主界面，不留进行中的垃圾状态），否则重新选层开始。
        "next": ["_SoCScoreFull", "SoCSelectLayer"]
    },

    // ---------- 入场券不足 2 张且补不满 → 收尾 ----------
    // 一层只有 500 分，打满 1000 需要 2 轮 = 2 张券。只剩 1 张时开新一轮通常打不满，
    // 白亏一张券和 8~19 分钟，不如直接结束等下期刷新。
    // ⚠️ 2026-11-09：不要「券 < 2 就一刀切收工」——券 1 张但只差一点点分时是误伤。
    //   现在券不足时会再读左下角「意识碎片 N/1000」，按每轮保守 355 分折算：
    //   只要 券数×355 ≥ 1000−当前分 就放行继续打；读不到积分才退回原行为（收工）。
    // 券数在选层界面右上角（券图标 + 数字，约 (1114,36)），只在选层后挂，不在 Resume 首位，
    // 避免在主界面把右上角资源数误读成 1。
    "_SoCTicketLow": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "券不足且补不满（自由探索已完成）→ 收尾结束"
        },
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SoCTicketLow"
            }
        },
        "next": ["_SoCReturnHome"]
    },

    // ---------- 积分已满 → 直接结束 ----------
    // 实机 2026-11-01：意识碎片 1000/1000 后游戏**不会阻止继续下潜**，
    // 只是把「深潜指引」变灰、自动降到「自由探索」（无奖励），程序会无意义地一直打下去白耗券。
    // 所以在选层界面读左下角「意识碎片 1000/1000」，满了就收工。
    // 该节点排 SoCResume.next 首位：只在选层界面能命中（左下角计数器），战斗中不会误判。
    "_SoCScoreFull": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "完成判定／意识碎片已满 1000 → 结束"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [20, 630, 250, 82],
                "expected": ["1000\\s*/\\s*1000", "1000/1000", "1000／1000"],
                "threshold": 0.8
            }
        },
        "next": ["_SoCReturnHome"]
    },

    // ---------- 全局 Buff 入口屏检测：「灵感节点 选择」卡片（最优先） ----------
    // ⚠️ 这是全局 Buff 选择阶段的**入口屏**（从配队/继续下潜后直接出现），检测优先级最高。
    //   模板用 autodori 的「认知海域灵感节点.png」（高清整卡裁切）；同时配 OCR 文字「灵感节点」双保险。
    //   命中（模板或文字任一）→ **显式点击「灵感节点」进入节点**（SoCInspirationClick）→ 再由 SoCGBLoop 处理全局 Buff 选择。
    //   「剩余可选灵感1/0」(SoCState_GB1/GB0) 作兜底：入口屏之后底部数字才出现。
    "SoCInspirationNode": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 0／检测到入口屏（灵感节点模板）→ 点击进入"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "SeaOfCognition/认知海域灵感节点.png",
                "threshold": 0.8,
                "roi": [192, 159, 358, 556]
            }
        },
        "next": ["SoCInspirationClick"]
    },

    // ---------- 入口屏文字识别兜底：OCR「灵感节点」（与模板双保险） ----------
    //   同指向上方的入口屏；当 autodori 模板因分辨率/UI 微调分数不足时，OCR 仍可命中。
    //   两者在 SoCResume / SoCTeamEnter 的 next 中并列，任一命中即进入点击流程。
    "SoCInspirationNodeOCR": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 0／检测到入口屏（灵感节点文字）→ 点击进入"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [192, 159, 358, 556],
                "expected": ["[灵靈]感[节節][点點]"],
                "threshold": 0.8
            }
        },
        "next": ["SoCInspirationClick"]
    },

    // ---------- 全局 Buff 界面检测：剩余可选灵感 = 1（还有名额） ----------
    "SoCState_GB1": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 0／检测到全局 Buff 选择（剩余可选灵感）"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [400, 560, 500, 110],
                "expected": ["剩余可选灵感"],
                "threshold": 0.8
            }
        },
        "next": ["SoCGBSwipe"]
    },

    // ---------- 全局 Buff 界面检测：剩余可选灵感 = 0（已选满） ----------
    "SoCState_GB0": {
        "focus": {
            "Node.PipelineNode.Starting": "步骤 0／检测到全局 Buff 选择（已选满）"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "SeaOfCognition/剩余可选灵感0.png",
                "threshold": 0.8
            }
        },
        "next": ["SoCGBLoop"]
    },

    // ---------- 未识别到中途状态：从 BCR 选层界面开始（默认从头） ----------
    "SoCFallbackStart": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 0／未识别中途状态 → 从 BCR 开始"
        },
        "recognition": "DirectHit",
        "next": [
            "SoCAtBCR",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_NavigateBCR"
        ]
    },

    // ---------- 进入认知海域：BCR 底部条「终局行动」 ----------
    // ⚠️ 2026-10-31 实机核对，原实现路径**完全错误**：
    //   原假设「BCR 底部条直接有认知海域图标」→ 实际 BCR 底部只有 5 项
    //   （终局行动 / 阈限禁区 / 特别行动 / 资源筹备 / 主线故事），认知海域在**终局行动**的二级菜单里，
    //   与「联线封锁」并排两张卡片。这才是 SoCAtBCR 永远匹配不到、进而与 ~BCR 自旋 289 次的真因。
    //   正确链路：BCR 底部「终局行动」→ 卡片区「认知海域」的「进入」→ 公告弹窗 → 奖励一览 → 选层。
    "SoCAtBCR": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 1／BCR 底部 → 点「终局行动」"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [420, 630, 300, 90],
                "expected": ["[终終]局行动", "[终終]局行動"],
                "threshold": 0.8
            }
        },
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "SoCEntryCognition",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_NavigateBCR",
            "[JumpBack]_NavigateHomepage"
        ]
    },

    // ---------- 进入认知海域：终局行动界面点「认知海域」卡片的「进入」 ----------
    // 该界面有两张卡（左「联线封锁」、右「认知海域」），底部各有一个「进入」按钮。
    // 用 roi 限定到右卡范围，避免点中左卡的「进入」。
    "SoCEntryCognition": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 1b／终局行动 → 点「认知海域」进入"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [430, 555, 270, 120],
                "expected": ["进入", "進入"],
                "threshold": 0.8
            }
        },
        "action": "Click",
        "post_delay": 2500,
        "next": [
            "_SoCNoticeClose",
            "_SoCRewardPanelClose",
            "_SoCTicketLow",
            "_SoCScoreFull",
            "SoCSelectLayer",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp"
        ]
    },

    // ---------- 首次进入的「注意 · 认知海域奖励已更新」公告 ----------
    // 实机 2026-10-31：进入后必定先弹此窗（居中标题「注意」+ 副标题「认知海域奖励已更新」+ 中央 ✓）。
    // 原实现完全没处理 → 任何「探测不到」都会落到 SoCFallbackStart 重新导航，形成空转。
    "_SoCNoticeClose": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 1c／关闭「奖励已更新」公告"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [300, 180, 700, 150],
                "expected": ["奖励已更新", "認知海域奖励", "认知海域奖励"],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [646, 391, 1, 1]
            }
        },
        "post_delay": 1500,
        "next": [
            "_SoCRewardPanelClose",
            "SoCSelectLayer"
        ]
    },

    // ---------- 奖励一览面板（右上 ✕ 关闭） ----------
