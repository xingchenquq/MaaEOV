    // ---------- 全局 Buff：「未选择灵感／是否放弃激发？」弹窗处理 ----------
    // 没选卡（clicked=0）就点「继续」时游戏弹此窗。
    // ⚠️ 2026-10-31 实机修正：原 target [760,520] 是空坐标，点了没反应 → 弹窗常驻遮挡界面
    //   → 后续 OCR 只能看到边缘被裁切的那张卡 → 选卡永远失败 → 回环。
    //   实测弹窗按钮：✕(取消放弃) 中心 [562,407]、✓(确认放弃) 中心 [732,407]。
    //   ⚠️ 2026-11-01 二次修正：原先点 ✕（取消放弃、回去继续选）会造成死循环——
    //   选卡失败时 → 点继续 → 弹窗 → 点 ✕ → 回 SoCGBLoop → 再选同一张 → 再失败，实测空转 12 分钟。
    //   改为点 **✓ 确认放弃激发**，直接进入战斗：宁可少拿 Buff 也不能把任务卡死在这里。
    "_SoCGBAbandonConfirm": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 7b／未选到灵感 → 放弃激发，直接进入战斗"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [200, 200, 880, 320],
                "expected": ["未选择灵感", "放弃激发"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [732, 407, 1, 1]
            }
        },
        "post_delay": 1500,
        // 放弃激发后回到阶段判定，由它决定进战斗还是别的，避免再回到选卡形成环
        "next": ["SoCResume"]
    },

    // ---------- 战斗节点循环入口 ----------
    // 优先找局内 Buff（「激发」出现）→ 打下一节点；
    // 找不到（全部节点打完，到领奖界面）→ 落到 SoCClaim。
    "SoCNodeLoop": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 8／循环 → 找下一个战斗节点"
        },
        // ⚠️ 2026-11-01 实机：最后一场战斗点完「继续」后，若界面还在结算动画里，
        //   原 next（只有局内 Buff + 领奖）会全部 miss → 任务直接 FAIL（实测第 2 轮 40 节点处）。
        //   补两条：仍在结算界面 → 再点一次继续；已退回选层 → 本轮结束。
        "next": [
            "SoCInBattleBuff",
            "SoCInBattleBuffOCR",
            "SoCContinue",
            "SoCClaim",
            "_SoCBackToLayer"
        ]
    },

    // ---------- 局内 Buff：识别界面 + 点左卡 ----------
    // 模板匹配「局内buff选择.png」（按用户实测 ROI=[517,130,249,35] 从 战斗节点开始.png 重裁，249×35，「请选择一个短暂灵感」标题）= 已进入战斗节点的局内 Buff 选择界面。
    // ⚠️ 之前用 OCR「激发」在 ROI [600,160,680,360] 匹配失败（20s 超时→任务失败），
    //   改用模板匹配此界面标题文字，比 OCR 稳定得多。
    // 识别成功后点左卡中心 [472,344]（左卡 ROI=[352,205,239,278]）；当前只点左卡两下确保选中，右卡点击留待后续加优先级。
    "SoCInBattleBuff": {
        "timeout": 900000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 8a／局内 Buff → 识别界面 + 点左卡"
        },
        "reco_timeout": 60000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "SeaOfCognition/局内buff选择.png",
                "threshold": 0.8
            }
        },
        // 2026-11-01：由「死点左卡 [472,344]」改为 CustomAction，读左右卡标题后按
        // resource/base/data/soc/buff_priority.json 打分选高分那张（低配可选生存向配置）。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SoCPickInBattleBuff"
            }
        },
        // 选卡失败（截图/OCR 崩）→ 兜底回到原逻辑：点左卡两次 + 激发
        "on_error": ["SoCInBattleBuff2nd"],
        "post_delay": 800,
        "next": [
            "SoCInBattleBuffConfirm",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_SeaOfCognitionReward"
        ]
    },

    // ---------- 局内 Buff：OCR 兜底（模板因背景/分辨率变化失配时启用） ----------
    //   与 SoCInBattleBuff 同 action + next，仅识别方式不同。
    //   挂在 SoCNodeLoop.next 的 SoCInBattleBuff 之后，仅当模板 miss 才触发。
    "SoCInBattleBuffOCR": {
        "timeout": 900000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 8a／局内 Buff → OCR 兜底识别 + 点左卡"
        },
        "reco_timeout": 60000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [490, 125, 320, 55],
                "expected": ["请选择一个短暂灵感"],
                "threshold": 0.8
            }
        },
        // 同 SoCInBattleBuff：按优先级表选卡，不再死点左卡
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SoCPickInBattleBuff"
            }
        },
        "on_error": ["SoCInBattleBuff2nd"],
        "post_delay": 800,
        "next": [
            "SoCInBattleBuffConfirm",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_SeaOfCognitionReward"
        ]
    },

    // ---------- 局内 Buff：点左卡 第2下（确保选中，无状态校验的兜底） ----------
    // 当前只点左卡（用户确认「选择一个」，先默认左卡）；右卡点击留待后续加局内 Buff 优先级时再做。
    // 点两下 + 隔 1s 再点激发：即便首点因动画/卡顿没生效，第2下也能补上选中。
    // 左卡 ROI=[352,205,239,278]，中心≈[472,344]。
    "SoCInBattleBuff2nd": {
        "timeout": 900000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 8b／局内 Buff → 点左卡 第2下 [472,344]"
        },
        "reco_timeout": 60000,
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [472, 344, 1, 1]
            }
        },
        "post_delay": 1000,
        "next": ["SoCInBattleBuffConfirm"]
    },

    // ---------- 局内 Buff：点「激发」确认 ----------
    // 模板匹配「QiFa.png」（激发按钮，按用户实测 ROI=[562,529,151,38] 重裁，151×38）。
    // ⚠️ 之前用 OCR「激发」同样可能失败；改用已裁好的按钮模板。
    "SoCInBattleBuffConfirm": {
        "timeout": 900000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 8c／局内 Buff → 点「激发」"
        },
        "reco_timeout": 60000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "SeaOfCognition/QiFa.png",
                "threshold": 0.8
            }
        },
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "SoCStartBattle",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_SeaOfCognitionReward"
        ]
    },

    // ---------- 战斗界面：点「开始作战」 ----------
    // ⚠️ 按钮实际文字是「开始**作**战」；OCR 逐字匹配容易因字体/误识别失败。
    //   改用模板匹配「认知海域开始作战.png」（取自 autodori，126×43），比 OCR 稳定。
    //   action 用裸 Click：TemplateMatch 命中后裸 Click 会点模板中心（同 QiFa 节点已验证）。
    "SoCStartBattle": {
        "timeout": 900000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 9／开始作战"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "SeaOfCognition/认知海域开始作战.png",
                "threshold": 0.8
            }
        },
        "action": "Click",
        "post_delay": 1000,
        "reco_timeout": 600000,
        "next": [
            "SoCAutoBattle",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_SeaOfCognitionReward"
        ]
    },

    // ---------- 自动战斗：轮询等待结算 + 关闭「获取物资」奖励弹窗 ----------
    // 战斗结束偶尔会弹「获取物资」奖励界面（先空白、随机点一下才出现标题，再点底部中央
    //   对号(✓)关闭，之后才出现右下「继续」结算按钮）。这种「先空白后弹窗」的时序无法用
    //   单一模板死等，故改用 CustomAction SoCAwaitBattle 做轮询：
    //     进入后静等 init_wait(30s) → 每 poll(5s) 截屏一次：
    //       · OCR「获取物资」→ 点底部中央 ✓ 关闭，下一轮继续找「继续」；
    //       · 模板匹配右下「继续」(战斗完成继续.png) → 返回 True，交回 SoCContinue 点击；
    //       · 都没有 → 双击屏幕中央跳过空白结束/过场界面。
    //   上限 max_wait(540s) 兜底，避免永久卡死。
    // ⚠️ reco_timeout/timeout 都给 600s：本节点会轮询最长 ~570s，而前序 SoCStartBattle
    //   的超时(默认 20s，已提到 600s)会穿透到下游，必须保证链路首节点预算充足。
    "SoCAutoBattle": {
        "focus": {
            "Node.PipelineNode.Starting": "步骤 10／自动战斗中（轮询等待结算 + 关闭奖励）"
        },
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SoCAwaitBattle",
                "custom_action_param": "{\"init_wait\":30,\"poll\":5,\"gap\":1,\"max_wait\":540,\"gift_roi\":[380,30,520,190],\"check_btn\":[640,650],\"tap\":[1250,510],\"task_done_roi\":[88,592,247,83]}"
            }
        },
        "reco_timeout": 600000,
        "timeout": 600000,
        // CustomAction 超过 max_wait(540s) 仍未等到「继续」时返回 False（v1.14.7 前是
        // return True 假装结算完成，会导致在错误界面继续点击）。失败后明确停止任务，
        // 取证件（截图 + JSON）落在 debug/evidence/，便于定位是"没结算完"还是 ROI 错位。
        "on_error": [
            "_StopTask"
        ],
        "next": [
            "_SoCBackToLayer",
            "SoCContinue",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_SeaOfCognitionReward"
        ]
    },

    // ---------- 战斗结束后已退回选层界面 → 本轮完成 ----------
    // 实机 2026-11-01：本轮最后一个战斗节点打完后，游戏直接退回选层界面
    // （左下意识碎片 500/1000、右下「开始下潜」），不存在「战斗完成继续」按钮。
    // 原实现只有 SoCContinue 一条路 → 匹配不到就一直等到 SoCAutoBattle 的 max_wait 超时被误判失败。
    // 现在由 SoCAwaitBattle 内部直接识别到站并返回 True，本节点再做一次确认并分流：
    //   · 本层只有 500 分，满额需 2 轮 → 未满必须继续下潜，不能就此收工
    //   · 已满 1000 → _SoCScoreFull 命中 → 回主界面收尾
    "_SoCBackToLayer": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 11c／本轮结束 → 判断是否继续下潜"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [820, 545, 460, 175],
                "expected": ["开始下[潜潛]", "继续下[潜潛]", "繼續下[潜潛]", "開始下[潜潛]"],
                "threshold": 0.8
            }
        },
        "next": [
            "_SoCScoreFull",
            "_SoCTicketLow",
            "SoCStartDive"
        ]
    },

    // ---------- 结算：点右下「继续」进入下一节点 ----------
    // 同上，改用模板匹配「战斗完成继续.png」。roi 同样约束右下角，避免战斗中右上「继续」误匹配。
    "SoCContinue": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "步骤 11／结算 → 点「继续」"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [950, 600, 330, 120],
                "template": "SeaOfCognition/战斗完成继续.png",
                "threshold": 0.8
            }
        },
        "action": "Click",
        // 结算→过场动画较长，1.0s 常常还在转场中就被下游重新扫描（实测导致 SoCNodeLoop 全 miss）
        "post_delay": 1800,
        "next": [
            "SoCAfterContinue",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_SeaOfCognitionReward"
        ]
    },

    // ---------- 继续后：检测是「战斗节点」还是「全局 Buff 选择节点」 ----------
    // 点「继续」后下一屏可能是：
    //   (a) 战斗节点（节点界面/局内 Buff）→ SoCNodeLoop 处理；
    //   (b) 全局 Buff 选择节点（出现「剩余可选灵感」）→ SoCGBLoop 处理。
    // 先查全局 Buff（有「剩余可选灵感」即命中），否则默认走 SoCNodeLoop（战斗节点）。
    // 复用 SoCState_GB1/GB0 检测器（路由到 SoCGBLoop）。
    "SoCAfterContinue": {
        "focus": {
            "Node.PipelineNode.Starting": "步骤 11b／继续后：检测战斗节点 or 全局 Buff"
        },
        "recognition": "DirectHit",
        "post_delay": 300,
        "next": [
            "SoCState_GB1",
            "SoCState_GB0",
            "SoCNodeLoop",
            "[JumpBack]_SoCGBAbandonConfirm",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_SeaOfCognitionReward"
        ]
    },

    // ---------- 领奖：点「领取」/「确认」→ 循环下一轮 ----------
    // 回到 BCR 再点认知海域图标，自动跑满（梦渊层约 2 次）。
    "SoCClaim": {
        "focus": {
            "Node.PipelineNode.Starting": "步骤 12／领奖"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 0, 1280, 720],
                "expected": ["[领領]取", "[确確][认認]"]
            }
        },
        "action": "Click",
        "post_delay": 1200,
        "next": [
            "SoCAtBCR",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_LevelUp",
            "[JumpBack]_CloseWindows",
            "[JumpBack]_SeaOfCognitionReward",
            "[JumpBack]_NavigateBCR"
        ]
    },

    // ---------- 入场券耗尽：检测到「入场券不足」类弹窗 → 正常结束 ----------
    "_SoCNoTicket": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "入场券不足 → 结束任务"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 0, 1280, 720],
                "expected": ["入场券不足", "入场券数量不足"]
            }
        },
        "next": ["_SoCReturnHome"]
    },

    // ---------- 收尾：返回游戏主界面 ----------
    // 完成/满分/券尽后，游戏仍停在认知海域选层界面。任务不能就这么结束——
    // 后续任务（清体力、补给站…）都假设从主界面开始，停在选层界面会让下一个任务直接失败。
    // 这里复用 Shared 的 _NavigateHomepage（含返回键 / 各弹窗兜底），退到主界面后再收尾。
    // ~Homepage 用左下角系统按钮模板判定；选层界面左下角是「意识碎片」，不会误判。
    "_SoCReturnHome": {
        "timeout": 240000,
        "focus": {
            "Node.PipelineNode.Starting": "收尾／返回游戏主界面"
        },
        // 退不出去不判失败：奖励已入账，卡在某个界面属于「尽力了」，交给下一个任务自己导航。
        "on_error": ["SoCDone"],
        "next": [
            "~SoCHome",
            "[JumpBack]_NavigateHomepage",
            "[JumpBack]_CancelGeneral",
            "[JumpBack]_CloseWindowsGeneral",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_LevelUp"
        ]
    },

    // ---------- 主界面汇点副本（识别同 ~Homepage，命中后收尾到 SoCDone） ----------
    // 不能直接挂 Shared 的 ~Homepage：它 next 为空，会在返回主界面后立刻结束任务，
    // 使 SoCDone 变成不可达孤儿节点（check_graph 会报）。
    "~SoCHome": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "收尾／已回到游戏主界面"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [32, 562, 137, 145],
                "template": "Homepage/SystemButton.png",
                "threshold": 0.8
            }
        },
        "next": ["SoCDone"]
    },

    // ---------- 任务成功结束 ----------
    "SoCDone": {
        "focus": {
            "Node.PipelineNode.Starting": "认知海域 · 任务结束"
        },
        "recognition": "DirectHit"
    }
}
