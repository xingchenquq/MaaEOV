{
    // ============================================================
    // 自动推图（v0.4.7，全流程）
    // 0) 进度播报：第 N 关 · 开始 / 结束（战斗胜利/未满星）｜已完成 M 关
    // 1) 入口：当前界面 → 识别未完成关卡 → 关卡详情 → 点击出发
    // 2) 战斗准备：等 5s → 每 1s 轮询"编队调整"直到出现 → 选择出战队伍 → 关闭编队 → 点击开始作战
    // 3) 战斗内：等战斗界面加载 → 点 AUTO → 确认弹窗点对号（倍速由游戏自动保持最高，无需切换）
    // 4) 战斗结束轮询三种结果：
    //      · 未满星（标题也是"战斗胜利"但有"注意"弹窗）→ 点"结算" → 连点退出
    //      · 战斗胜利 → 连点退出
    //      · 战斗失败（3 判定任一）→ 播报失败并结束任务
    //    胜利/未满星 → 连点 (640,30)×8 → 回到"识别未完成关卡"循环
    // 基准分辨率：1280×720
    //
    // 用户给定素材：
    //   - 未完成关卡.png：关卡卡片上的 0星标记（空星），标识"未通关"
    //   - 开始作战.png："开始作战"按钮（判定战斗准备就绪 / 最终点击开战）
    //   - 编队调整.png / 编队选择.png / 编队选择关闭.png：编队相关
    //   - 战斗编队1~5.png：出战队伍数字
    //   - auto.png / 自动战斗确认.png：AUTO 按钮 / 确认弹窗金色对号
    //   - 战斗胜利界面.png / 战斗胜利战利品.png：胜利（标题+战利品双判定）
    //   - 战斗未满星界面.png / 战斗未满星结算.png：未满星（点结算）
    //   - 战斗失败界面.png / 战斗失败条件.png / 战斗失败退出.png：失败（三判定）
    // ============================================================

    // ---------- 任务入口 ----------
    "#自动推图": {
        "timeout": 900000,
        "next": ["播报前提"]
    },

    // ---------- 前提提醒（每次任务开始只打一次）----------
    // ⚠️ 本任务未做"自动吃体力"配置：请确保体力充足，否则可能进不了关卡。
    "播报前提": {
        "timeout": 30000,
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "播报进度",
                "custom_action_param": "{\"stage\":\"notice\"}"
            }
        },
        "next": ["播报开始"]
    },

    // ---------- 进度播报：本关开始（让 exe 日志更直观） ----------
    // 由 CustomAction「播报进度」维护关卡计数，输出：第 N 关 · 开始
    "播报开始": {
        "timeout": 30000,
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "播报进度",
                "custom_action_param": "{\"stage\":\"start\"}"
            }
        },
        "next": ["巡检关卡"]
    },

    // ---------- 巡检关卡：找未完成关卡；找不到 → 播报"推图完成"并结束 ----------
    // MaaFramework：next 里多项时，前项识别不到会落到后项（前项不吃自己的 timeout）。
    // 故把"识别未完成关卡"放前面、失败兜底"推图完成"放后面。
    "巡检关卡": {
        "timeout": 3000,
        "recognition": "DirectHit",
        "next": ["识别未完成关卡", "推图完成"]
    },

    // 未找到未完成关卡（全部推完）→ 播报后正常结束
    "推图完成": {
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "播报进度",
                "custom_action_param": "{\"stage\":\"done\"}"
            }
        },
        "next": []
    },

    // ---------- 步骤 1：在当前关卡列表界面识别"未完成关卡"并点击 ----------
    // 截图：assets/resource/image/未完成关卡.png（空星图标）
    // 当前界面 = 关卡列表/章节界面（用户开局就在这里）。
    // 全屏 ROI 覆盖整个关卡列表，避免限制位置。
    // 命中 → 点击空星所在位置（关卡卡片通常就在空星附近）。
    "识别未完成关卡": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [0, 0, 1280, 720],
                "template": "自动推图/未完成关卡.png",
                // ⚠️ 阈值 0.80：这张"三颗空心星(0/3)"叠在半透明深色底上，分数随背景波动。
                //   实测：真·0 星（未完成）≈ 0.87，2 星（已通）≈ 0.71。阈值要在两者之间——
                //   0.85 会漏掉偏暗的 0 星；0.65 会把 2 星误认成 0 星。取 0.80。
                "threshold": 0.80
            }
        },
        "action": "Click",
        // ⚠️ 不用 post_wait_freezes（"等画面静止"）：关卡详情进场动画会让它实际等 3~4s（实测 3.4s）；
        //    改固定短延时即可——后续"巡检出发"会多次重试，不必在点击后死等画面静止。
        "post_delay": 600,
        "next": ["巡检出发"]
    },

    // ---------- 步骤 2：进入关卡详情页后，识别并点击"出发" ----------
    // 用户给定 ROI [784,588,496,149]（h 已 clamp 到 720 边界内），OCR 期望"出发"。
    "识别出发": {
        "timeout": 930000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [784, 588, 496, 132],
                "expected": ["出发"]
            }
        },
        "action": "Click",
        // 同上：不用 post_wait_freezes（实测这里也等了 4.4s），改固定短延时；
        // 后续"~战斗准备就绪"自己有 timeout 轮询兜底。
        "post_delay": 600,
        // 直接进"等待编队出现"：等 5s → 每 1s 轮询"编队调整"直到出现。
        // 不再单独等"开始作战"按钮：它和"编队调整"在同一张战斗准备界面上，用后者当就绪判据更省时间。
        "next": ["等待编队出现"]
    },

    // ---------- 巡检"出发"：点完关卡卡片后，等详情页出来再点"出发" ----------
    // 为什么需要：间歇出现"点开的卡片不是带'出发'的关卡详情页"
    //   （实测点 [625,341] 后 20s 都读不到"出发" → 任务超时结束）。
    // 规则：最多试 4 次（每次间隔 ~0.8s，避免详情页还没出来就误判失败）；
    //       仍失败 → `识别出发失败处理` 存现场截图到 debug/ 便于排查，再结束任务。
    "巡检出发": {
        "timeout": 3000,
        "recognition": "DirectHit",
        "post_delay": 800,
        "next": ["识别出发", "巡检出发2"]
    },

    "巡检出发2": {
        "timeout": 3000,
        "recognition": "DirectHit",
        "post_delay": 800,
        "next": ["识别出发", "巡检出发3"]
    },

    "巡检出发3": {
        "timeout": 3000,
        "recognition": "DirectHit",
        "post_delay": 800,
        "next": ["识别出发", "巡检出发4"]
    },

    "巡检出发4": {
        "timeout": 3000,
        "recognition": "DirectHit",
        "post_delay": 800,
        "next": ["识别出发", "识别出发失败处理"]
    },

    // 连续 4 次都读不到"出发" → 存现场截图（debug/_fail_识别出发.png），方便定位"选不上下一关"的原因
    "识别出发失败处理": {
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "存失败截图",
                "custom_action_param": "{\"name\":\"_fail_识别出发\"}"
            }
        },
        "next": []
    },

    // ============================================================
    // 战斗准备阶段：等 5s → 「检测编队调整 ↔ 跳过介绍」循环直到命中
    // ============================================================
    // 说明：
    //   ① 不再单独等 `~战斗准备就绪`（开始作战按钮）——它和"编队调整"在同一张战斗准备界面上，
    //      直接用"编队调整"出现作为就绪判据，省掉一次长等待（部分关卡无加载动画时纯属无效时间）。
    //   ② "跳过介绍"保留：boss/机制介绍是视频，期间"编队调整"还没出现，循环里顺带点 [1218,273] 加速跳过。
    //   ③ ⚠️ MaaFramework 语义：`next` 里有多项时，**前面各项只试一次、不吃自己的 timeout**。
    //      故用「巡检节点(2 项 next)」实现"检测一次 → 没中就点跳过"，不要指望子节点的 timeout。

    // ---------- 步骤 3a：点击"出发"后先等 5s，再开始检测编队调整 ----------
    "等待编队出现": {
        "timeout": 900000,
        "recognition": "DirectHit",
        "post_delay": 5000,
        "next": ["巡检编队"]
    },

    // 巡检：先试一次"编队调整"；没命中就落到"点击跳过介绍"
    "巡检编队": {
        "timeout": 3000,
        "recognition": "DirectHit",
        "next": ["编队调整检测", "点击跳过介绍"]
    },

    // ---------- 步骤 4：识别并点击"编队调整" ----------
    // 截图：assets/resource/image/编队调整_文字.png（168×36，从 编队调整.png 裁出的"文字区"）
    // 为什么裁成文字：原整块 244×72 模板含半透明按钮底，会被战斗地图背景拖分——
    //   实测同一按钮在不同关卡只打 **0.67~0.81**（背景不同），0.85 / 0.70 阈值都会漏检；
    //   只匹配**不透明的"编队调整"文字**，分数稳定得多。
    // 命中即点击文字框中心（≈ 按钮中心）→ ~进入编队选择；未命中 → 巡检的 next[1] = 点击跳过介绍。
    "编队调整检测": {
        "timeout": 3000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1000, 439, 280, 132],
                "template": "自动推图/编队调整_文字.png",
                "threshold": 0.70
            }
        },
        "action": "Click",
        "post_delay": 1500,
        "next": ["~进入编队选择"]
    },

    // 点一下 [1218,273] 跳过 boss/机制介绍，然后回"巡检编队"继续（检测 ↔ 跳过 循环）
    "点击跳过介绍": {
        "timeout": 30000,
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [1218, 273, 1, 1]
            }
        },
        "post_delay": 800,
        "next": ["巡检编队"]
    },

    // ---------- 步骤 5：确认已进入编队选择界面 ----------
    // 用"编队选择关闭"按钮（右上角"×"）作为判定特征，比整屏 编队选择.png 更快更稳。
    // 经 编队选择.png 定位：关闭按钮 box=[1115,69,38,38]，中心 (1134,88)
    // ROI 外扩 30px = [1085,39,95,98]。
    "~进入编队选择": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1085, 39, 95, 98],
                "template": "自动推图/编队选择关闭.png",
                "threshold": 0.85
            }
        },
        "timeout": 5000,
        "next": ["选择出战队伍"]
    },

    // ---------- 步骤 6：选择出战队伍（数字模板匹配 + 偏移点击） ----------
    // ⚠️ 为什么不用 OCR：实测 OCR 在该区域只能读到"覆盖至此"按钮文字，**读不到大号队伍数字**
    //    （PP-OCR 对这种装饰数字检测不出来）→ expected 永远匹配不上、任务超时结束。
    //    改用数字模板 战斗编队N.png（用户提供，1~5）。
    //   1. 在「该队伍的整行 ROI」内匹配 战斗编队N.png
    //      —— 行 ROI 只框一行，天然避免 4/5 的模板误匹配到可见的 3（实测 5 与 3 相似度 0.95）。
    //   2. 命中后点击「该数字框 + target_offset」："读取"按钮 x 中心 1044；
    //      数字框 [228,362,35,48] → 偏移 = 1027-228 = 799（各行一致）。
    //   行 ROI 纵坐标 = 350 + (N-1)*137，高 80（覆盖该行数字，~137 行距不会串行）。
    // ⚠️ 用户明确：暂不做"上滑查看更多队伍(4/5)"，故 4/5 的行 ROI 在屏外，匹配不到即安全失败。
    // UI 选项"出战队伍"通过 pipeline_override 覆盖 template 与 roi。
    "选择出战队伍": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [166, 350, 146, 80],
                "template": "自动推图/战斗编队1.png",
                "threshold": 0.85
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [799, 0, 0, 0]
            }
        },
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "post_delay": 3000,
        "next": ["点击关闭编队", "选择出战队伍_重试"]
    },

    // ---------- 步骤 6-fallback：当前屏没找到目标队伍 → 原地重试一次 ----------
    // （不做上滑；与上面同款，只重新匹配一遍）
    "选择出战队伍_重试": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [166, 350, 146, 80],
                "template": "自动推图/战斗编队1.png",
                "threshold": 0.85
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [799, 0, 0, 0]
            }
        },
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "post_delay": 3000,
        "next": ["点击关闭编队", "选择出战队伍_失败停止"]
    },

    // ---------- 步骤 6-fallback-2：两次都找不到 → 点关闭编队，结束任务 ----------
    // 不直接卡死，先把弹窗关上，避免影响后续任务。
    "选择出战队伍_失败停止": {
        "timeout": 30000,
        "recognition": "DirectHit",
        "next": ["点击关闭编队"]
    },

    // ---------- 步骤 7：关闭编队选择界面 ----------
    // 截图：assets/resource/image/编队选择关闭.png（38×38）
    // 经 编队选择.png 定位：关闭按钮 box=[1115,69,38,38]，中心 (1134,88)
    // ROI 外扩 30px = [1085,39,95,98]。
    "点击关闭编队": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1085, 39, 95, 98],
                "template": "自动推图/编队选择关闭.png",
                "threshold": 0.85
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "post_delay": 1000,
        "next": ["点击开始作战", "点击关闭编队_重试"]
    },

    // ---------- 步骤 7-重试：第一次没关闭时再来一次 ----------
    "点击关闭编队_重试": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1085, 39, 95, 98],
                "template": "自动推图/编队选择关闭.png",
                "threshold": 0.85
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        "post_delay": 1000,
        "next": ["点击开始作战"]
    },

    // ---------- 步骤 8：点击"开始作战"正式进入战斗 ----------
    // 截图：assets/resource/image/开始作战.png（实际 137×51）
    // 经 战斗准备界面.png 定位："开始作战"按钮 box=[1066,623,137,51]，中心 (1134,648)
    // ROI 外扩 30px = [1036,593,197,111]。
    // 点击后进入战斗界面（加载需时间）→ 转"战斗内流程"首节点 ~战斗界面已加载。
    "点击开始作战": {
        "timeout": 930000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1036, 593, 197, 111],
                "template": "自动推图/开始作战.png",
                "threshold": 0.85
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 1500,
            "threshold": 0.85
        },
        "post_delay": 1000,
        "next": ["~战斗界面已加载"]
    },

    // ============================================================
    // 战斗内流程（v0.4.7：去掉倍速逻辑 —— 游戏本身会保持最高战斗倍速）
    // ============================================================

    // ---------- 战斗内 · 步骤 8.5：等战斗界面加载完成（AUTO 按钮出现）----------
    // 开始作战后战斗场景加载需时间；用 auto.png（AUTO 按钮）作为"已进战斗"的标志。
    "~战斗界面已加载": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [790, 10, 140, 80],
                "template": "自动推图/auto.png",
                "threshold": 0.70
            }
        },
        "timeout": 60000,
        "next": ["点击自动战斗"]
    },

    // 已删除：原"倍速拉到 3X"逻辑（~已三倍速 / 点击倍速 / ~已三倍速_2 / 点击倍速_2）
    //   用户 2026-09-12 确认：游戏会保持最高战斗倍速，脚本无需切换。
    //   （对应模板 战斗三倍速.png / 战斗三倍速_数字.png 保留在 image 目录备用）

    // ---------- 战斗内 · 步骤 10：开启自动战斗 ----------
    // 用户给定：进战斗默认 auto 关闭 → 点 auto.png（AUTO 按钮 box=[814,29,88,44]，中心 (858,51)）
    //           → 出现"要启用自主作战吗？"确认弹窗 → 点右下金色对号 自动战斗确认.png
    //             （对号在弹窗内 box=[694,370,58,52]，中心 (723,396)；用户给定确认区 [425,220,410,231]）
    "点击自动战斗": {
        "timeout": 900000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [790, 10, 140, 80],
                "template": "自动推图/auto.png",
                "threshold": 0.70
            }
        },
        "action": "Click",
        "post_delay": 1200,
        "next": ["点击自动确认", "点击自动确认_重试"]
    },

    "点击自动确认": {
        "timeout": 930000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [425, 220, 410, 231],
                "template": "自动推图/自动战斗确认.png",
                "threshold": 0.80
            }
        },
        "action": "Click",
        "post_delay": 1500,
        "next": ["自动战斗已开启"]
    },

    // 保险：第一次没识别到对号时再试（弹窗动画可能慢）
    "点击自动确认_重试": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [425, 220, 410, 231],
                "template": "自动推图/自动战斗确认.png",
                "threshold": 0.80
            }
        },
        "action": "Click",
        "post_delay": 1500,
        "next": ["自动战斗已开启"]
    },

    // 战斗内前置动作完成 → 进入"等战斗结束"轮询
    "自动战斗已开启": {
        "timeout": 900000,
        "recognition": "DirectHit",
        "next": ["等待战斗结束"]
    },

    // ============================================================
    // 战斗结束：轮询三种结算界面（v0.4 新增）
    // ⚠️ 顺序很重要：未满星界面的标题**也是"战斗胜利"**，只是多了一个"注意(回溯)"弹窗，
    //    所以必须**先判未满星**，再判纯胜利。
    // 每个判定节点 timeout 设短(800ms)以便快速轮询；全部未命中 → 隔 1s 再来一轮。
    // ============================================================

    "等待战斗结束": {
        "timeout": 900000,
        "recognition": "DirectHit",
        "next": [
            "点击未满星结算",
            "~战斗胜利_标题",
            "~战斗胜利_战利品",
            "~战斗失败_标题",
            "~战斗失败_条件",
            "~战斗失败_退出",
            "等待战斗结束_间隔"
        ]
    },

    "等待战斗结束_间隔": {
        "timeout": 900000,
        "recognition": "DirectHit",
        "post_delay": 1000,
        "next": ["等待战斗结束"]
    },

    // ---------- 情况 1：战斗胜利 ----------
    // 判定一：右上"战斗胜利"四个字（可能被立绘遮挡）
    "~战斗胜利_标题": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [873, 114, 401, 280],
                "expected": ["战斗胜利"]
            }
        },
        "timeout": 800,
        "next": ["播报胜利"]
    },

    // 判定二：右下"战利品"文字（战斗胜利界面才有）
    "~战斗胜利_战利品": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1086, 409, 166, 71],
                "template": "自动推图/战斗胜利战利品.png",
                "threshold": 0.80
            }
        },
        "timeout": 800,
        "next": ["播报胜利"]
    },

    // ---------- 情况 2：战斗未满星（标题同样是"战斗胜利"，但带"注意"回溯弹窗）----------
    // 在弹窗区 [804,406,451,234] 内识别"结算"按钮 → 直接点它
    "点击未满星结算": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [804, 406, 451, 234],
                "template": "自动推图/战斗未满星结算.png",
                "threshold": 0.80
            }
        },
        "action": "Click",
        "timeout": 800,
        "post_delay": 1500,
        "next": ["播报未满星"]
    },

    // ---------- 情况 3：战斗失败（三个判定，任一命中即判失败）----------
    // ⚠️ 用户给的"战斗失败"检测 ROI [1086,409,166,71] 实际框到的是失败界面的"强化策略"提示
    //    （那是胜利界面"战利品"的坐标）；已按标题实际位置改为 [855,110,430,160]。
    "~战斗失败_标题": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [855, 110, 425, 160],
                "expected": ["战斗失败"]
            }
        },
        "timeout": 800,
        "next": ["处理战斗失败"]
    },

    "~战斗失败_条件": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1088, 203, 122, 153],
                "template": "自动推图/战斗失败条件.png",
                "threshold": 0.80
            }
        },
        "timeout": 800,
        "next": ["处理战斗失败"]
    },

    "~战斗失败_退出": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [957, 598, 257, 64],
                "template": "自动推图/战斗失败退出.png",
                "threshold": 0.80
            }
        },
        "timeout": 800,
        "next": ["处理战斗失败"]
    },

    // 失败 → 打印通知并结束任务（next 空 = 任务结束）
    "处理战斗失败": {
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "播报进度",
                "custom_action_param": "{\"stage\":\"fail\"}"
            }
        },
        "next": []
    },

    // ---------- 进度播报：本关结束 ----------
    "播报胜利": {
        "timeout": 30000,
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "播报进度",
                "custom_action_param": "{\"stage\":\"win\"}"
            }
        },
        "next": ["连点退出并重扫"]
    },

    "播报未满星": {
        "timeout": 30000,
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "播报进度",
                "custom_action_param": "{\"stage\":\"nostar\"}"
            }
        },
        "next": ["连点退出并重扫"]
    },

    // ---------- 胜利 / 未满星 共用收尾：连点 (640,30) 8 次（每次间隔 1s）→ 回"播报开始"开下一关 ----------
    "连点退出并重扫": {
        "timeout": 30000,
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "连点退出",
                "custom_action_param": "{\"times\":8,\"interval\":1.0,\"x\":640,\"y\":30}"
            }
        },
        "next": ["播报开始"]
    }
}