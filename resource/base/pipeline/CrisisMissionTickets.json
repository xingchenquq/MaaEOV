{
    // ============================================================
    // CrisisMissionTickets.json
    // 功能：危机行动调令
    // 入口节点：#CrisisMissionTickets
    // 说明：
    //   1) 先进入「危机行动」界面（_NavigateCrisisMission = 点击「危机行动」入口，
    //      已迁入特别行动界面，会自动走 特别行动.png → 危机行动.png），
    //      再在危机行动界面内用模板「危机行动调令.png」(roi [1165,15,94,45]) 确认调令 HUD 存在，
    //      随后在图标左侧 OCR 读出调令数量并记录。
    //      调令为 0 时无法进入关卡详情页，故在危机行动界面内提前判定：数量为 0 直接跳过
    //      （不进入详情页、不触发战斗）；大于 0 才选关进入详情页。
    //   2) 进入详情页后，按往期活动同范式「一次完成」：CustomAction「设置危机行动战斗次数」在扫荡弹窗内
    //      把次数设为调令数（滑块拉到最左归 1，再点加号 N-1 次），随后由 Shared 的「点击出发」一次性确认，
    //      一次扫完所有次数后等待结算、点确定、退出详情页、返回主界面——而非逐次循环。
    //   由 scripts/split_pipeline.py 从 Tasks.json 拆分生成；请勿跨文件重复定义同名节点。
    // 本文件节点数 = 12
    // 依赖 Shared.json 节点数：_NavigateBCR / _NavigateCrisisMission / ~CrisisMission / _HomeButton / ~Homepage / _NavigateS502 / ~S502 /
    //   _ServerMaintenance / _ConfirmReconnect / _ConfirmSweepResult / _LevelUp /
    //   点击出发 / ~等待快速完成结果 / 点击确定 / 退出关卡详情页 / 返回主界面
    // ============================================================

    // ---------- 任务入口：#CrisisMissionTickets（危机行动调令） ----------

    // Entry
    "#CrisisMissionTickets": {
        "focus": {
            "Node.PipelineNode.Starting": "危机行动调令 · 任务开始",
            "Node.PipelineNode.Completed": "危机行动调令 · 完成",
            "Node.PipelineNode.Failed": "危机行动调令 · 失败"
        },
        "next": [
            "CrisisMissionTickets"
        ]
    },

    // Logic：首位必须是 BCR 根屏门控（OCR「主线故事」，仅在 BCR 命中）——在主界面等其它屏
    // 不命中，落到 [JumpBack]_NavigateBCR 先导航回 BCR（Farm.json 同款成熟范式）。
    // ⚠️ 不能把无识别的 DirectHit 路由节点放首位：它永远命中，会挡死后面的导航兜底。
    "CrisisMissionTickets": {
        "timeout": 120000,
        "next": [
            "CrisisMissionTicketsFromBCR",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_NavigateBCR"
        ]
    },

    // BCR 根屏门控 + 探测：探测节点写小 timeout，避免吃光父节点预算导致兄弟兜底不执行。
    "CrisisMissionTicketsFromBCR": {
        "focus": {
            "Node.PipelineNode.Starting": "危机行动 · 已定位到 BCR 根界面"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1080,
                    607,
                    200,
                    113
                ],
                "expected": [
                    "主线故事"
                ]
            }
        },
        "timeout": 5000,
        "next": [
            "CrisisMissionTicketsEnterCM"
        ]
    },

    // 进入危机行动界面：优先检测调令 HUD（说明已在危机行动界面），否则先导航进入。
    // 注意：调令 HUD 只存在于「危机行动」界面内，BCR 根屏不可见，故必须先进入界面再读调令。
    // ⚠️ 导航必须用 [JumpBack]：裸写 _NavigateCrisisMission 时导航链一路前向走到 ~CrisisMission
    //   （成功终态）整个任务就结束了——实测 15:12 运行正是如此（进入界面即"任务完成"，后续全没跑）。
    //   加 [JumpBack] 后每轮导航完回环重扫：未到界面继续导航，到了界面 HUD 命中继续往下走。
    // 末位 Skipped（DirectHit 永远命中）兜底：已在界面但 HUD 模板意外不命中时，走"跳过+返回主界面"
    //   而不是报 no valid node in next。
    "CrisisMissionTicketsEnterCM": {
        "focus": {
            "Node.PipelineNode.Starting": "危机行动 · 正在进入危机行动界面"
        },
        "timeout": 60000,
        "next": [
            "确认在危机行动界面",
            "[JumpBack]_NavigateCrisisMission"
        ]
    },

    // ---------- 界面确认（模板，纯图标不含数字） ----------
    // ⚠️ 必须与下面的读数字分开：AtCrisisMission.png 是纯 B.R.C 图标（不含调令数字），
    // 用它判"是否在危机行动界面"才不受调令数变化影响。
    // 反例：若单靠 OCR 任意数字判界面，主界面同位置也能读到数字（实测读到 "50"）→ 误判。
    "确认在危机行动界面": {
        "timeout": 5000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1122,
                    0,
                    142,
                    130
                ],
                "template": "BCR/危机行动_界面标志.png",
                "threshold": 0.8
            }
        },
        "next": [
            "检测危机行动调令HUD"
        ]
    },

    // ---------- 调令 HUD 检测 + 读数（单次 OCR） ----------
    // ⚠️ 2026-10-21 实机修正两处：
    //  1) 原用模板「危机行动调令.png」判定 HUD 存在，但该模板是「B.R.C 图标 + 数字 0」的
    //     合成图，**调令数一旦不是 0 就必然失配**（实测调令=4 时不命中 → 直接 Skipped，
    //     任务永远跳过不打）。改用 OCR 识别调令数字（实测同位置 score 0.9957 稳定命中）。
    //  2) 原来"HUD 检测"与"读数"是两个串联的 OCR 节点，实测第二个 OCR 会在刚进界面的
    //     动画期识别失败（HUD 命中 → 读数不命中 → 落 Skipped，26~32s 就跳过）。
    //     现合并为**单次 OCR**：本节点识别数字即完成"确认在界面"+"读数"，
    //     custom_action 直接取本次 reco_detail。
    "检测危机行动调令HUD": {
        "focus": {
            "Node.PipelineNode.Starting": "危机行动 · 已进入危机行动界面，正在读取调令数量"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1210,
                    22,
                    30,
                    33
                ],
                "expected": [
                    "[0-9]"
                ]
            }
        },
        "timeout": 8000,
        // 刚进界面时调令数字还在渲染（实测间歇性读不到），识别前先等画面出来。
        // ⚠️ 不能用 post_delay：实测加 post_delay 后本节点直接不命中（8s 窗口内不再重试），
        //    任务于是永远走 Skipped。
        "pre_delay": 1500,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "记录危机行动调令数"
            }
        },
        "next": [
            "~危机行动调令为零",
            "[JumpBack]CrisisMissionTicketsSelectLevel"
        ]
    },

    "~危机行动调令为零": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "危机行动 · 调令为 0，跳过扫荡"
        },
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "危机行动调令为零"
            }
        },
        "next": [
            "CrisisMissionTicketsSkipped"
        ]
    },

    // 跳过终态：调令=0 / HUD 未命中 / 扫荡兜底 三处共用。
    // 不能直接成功结束——此时仍停在危机行动（或下游）界面，必须把"返回主界面"做掉，
    // 否则后续任务从主界面起跳会找不到根屏。
    // 先点通用主页按钮（Utils/HomeButton.png，跨界面存在），再 ~Homepage 验证到家成功。
    "CrisisMissionTicketsSkipped": {
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Starting": "危机行动 · 跳过扫荡，正在返回主界面"
        },
        "recognition": "DirectHit",
        "roi": [
            0,
            0,
            1,
            1
        ],
        "next": [
            "_HomeButton",
            "~Homepage"
        ]
    },

    // 选关：导航到目标关卡（默认幻影人偶Ⅱ / S502）的详情页，然后**立即接力**到「快速完成」。
    // ⚠️ 2026-10-21 实机修正：原先「快速完成」排在选关之前（见 检测危机行动调令HUD.next），
    //    且关卡**列表页底部也有「快速完成」按钮**，于是任务直接对"游戏当前选中的关卡"开扫荡，
    //    option 指定的关卡完全不生效（实测选中 S001 + option=S303 → 对 S001 弹快速完成窗）。
    //    现在选关先行：_NavigateSxxx 是 inverse gate（已在目标关卡则不动作）→ 落到第二项
    //    CrisisMissionTicketsFromLevel；未在目标关卡 → 导航点击 → 到达后 ~Sxxx 命中弹回本节点
    //    重扫 → gate 不动作 → 落到 FromLevel。option 的每个 case 也同样带第二项。
    // timeout 120000：须覆盖下游「点击出发」+「等待结果」整条扫荡链（最长约 70s）。
    "CrisisMissionTicketsSelectLevel": {
        "focus": {
            "Node.PipelineNode.Starting": "危机行动调令 · 选择关卡"
        },
        "timeout": 120000,
        "next": [
            "_NavigateS502",
            "CrisisMissionTicketsFromLevel"
        ]
    },

    // 关卡详情页：识别并点击「快速完成」打开扫荡弹窗，再进入设置次数流程。
    // timeout 80000：须覆盖下游「设置次数 → 点击出发 → 等待结果」整条链（最长约 70s）。
    // 关键：必须 Click 才能真正弹出 AtSweep 弹窗，否则下游 SweepStrategy（AtSweep.png）
    // 永远匹配不到，会一路回落到 [JumpBack]CrisisMissionTicketsSelectLevel 空转超时。
    "CrisisMissionTicketsFromLevel": {
        "timeout": 80000,
        "focus": {
            "Node.PipelineNode.Starting": "危机行动 · 已进入关卡详情页，点击「快速完成」"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    804,
                    591,
                    273,
                    129
                ],
                "expected": [
                    "快速完成"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 1200,
            "threshold": 0.85
        },
        // 2026-11-03：末位原本是 [JumpBack]CrisisMissionTicketsSelectLevel（重试选关）。
        // 扫荡是一次性把全部调令打完（设置次数=调令数），结算后已经回到主界面，
        // 此时再「选关」在主界面找不到关卡 → 一路回落到导航 → 任务被判 FAIL
        // （实测 94.6s、35 节点、调令已消耗）。改为直接走 Skipped 收尾。
        "next": [
            "CrisisMissionTicketsSweepStrategy",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmSweepResult",
            "[JumpBack]_LevelUp",
            "CrisisMissionTicketsSkipped"
        ]
    },

    // 扫荡弹窗已打开（BCR/扫荡弹窗_界面标志.png 命中），进入设置战斗次数。
    // timeout 80000：覆盖下游「设置次数 → 点击出发 → 等待结果」最长约 70s 的耗时。
    "CrisisMissionTicketsSweepStrategy": {
        "timeout": 80000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    148,
                    176,
                    308,
                    292
                ],
                "template": "BCR/扫荡弹窗_界面标志.png"
            }
        },
        "next": [
            "设置危机行动战斗次数"
        ]
    },

    // 设置战斗次数（滑块归 1 + 点加号 N-1 次），随后一次性确认出发。
    // timeout 80000：覆盖下游「点击出发 → 等待结果」最长约 70s 的耗时。
    // 若调令数 <= 0（理论上不会到这，界面内已拦截），custom_action 返回 False，
    // 落到 next 兜底直接结束，避免空扫荡。
    "设置危机行动战斗次数": {
        "timeout": 80000,
        "focus": {
            "Node.PipelineNode.Starting": "危机行动 · 正在设置扫荡次数"
        },
        "recognition": "DirectHit",
        "roi": [
            0,
            0,
            1,
            1
        ],
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "设置危机行动战斗次数"
            }
        },
        "next": [
            "点击出发",
            "CrisisMissionTicketsSkipped"
        ]
    }
}
