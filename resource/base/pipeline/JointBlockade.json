    // 依赖 Shared.json 节点数 = 7（示例：_ConfirmMiddle, _ConfrimReconnect, _NavigateBCR, _NavigateSystem, _ServerMaintenance, _SweepConfirm）
    // ============================================================

    "~JointBlockade": {
