{
    // ============================================================
    // CollectRewards.json
    // 功能：领取任务奖励
    // 入口节点：DailyReward（聚合入口见 Aggregated.json 的 #一键领取）
    // 说明：领取日常任务、周常任务奖励。
    // 由 scripts/split_pipeline.py 从 Tasks.json 拆分生成；请勿跨文件重复定义同名节点。
    // 本文件节点数 = 10
    // 依赖 Shared.json 节点数 = 5（示例：_CloseMutualAid, _ConfirmMiddle, _ConfirmReconnect, _NavigateMission, _ServerMaintenance）
    // ============================================================

    "~DailyMission": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    677,
                    0,
                    214,
                    135
                ],
                "template": "Mission/日常任务_页签.png",
                "threshold": 0.8
            }
        }
    },

    "~WeeklyMission": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    867,
                    0,
                    209,
                    131
                ],
                "template": "Mission/周常任务_页签.png",
                "threshold": 0.8
            }
        }
    },

    // Navigate to Daily Mission Tab
    "_NavigateDailyMission": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    677,
                    0,
                    214,
                    135
                ],
                "template": "Mission/日常任务_页签.png",
                "threshold": 0.8
            }
        },
        "inverse": true,
        "next": [
            "~DailyMission",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_CloseMutualAid",
            "[JumpBack]_DailyFromMission",
            "[JumpBack]_NavigateMission"
        ]
    },

    "_DailyFromMission": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    677,
                    0,
                    214,
                    135
                ],
                "template": "Mission/DailyMission.png"
            }
        },
        "action": "Click",
        "post_wait_freezes": 1000
    },

    // Navigate to Weekly Mission Tab
    "_NavigateWeeklyMission": {
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    867,
                    0,
                    209,
                    131
                ],
                "template": "Mission/周常任务_页签.png",
                "threshold": 0.8
            }
        },
        "inverse": true,
        "next": [
            "~WeeklyMission",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmMiddle",
            "[JumpBack]_CloseMutualAid",
            "[JumpBack]_WeeklyFromMission",
            "[JumpBack]_NavigateMission"
        ]
    },

    "_WeeklyFromMission": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    867,
                    0,
                    208,
                    132
                ],
                "template": "Mission/WeeklyMission.png"
            }
        },
        "action": "Click",
        "post_wait_freezes": 1000
    },

    // ---------- 子链：领取任务奖励（由 Aggregated.json 的 #一键领取 经 [JumpBack]DailyReward 调用） ----------

    // Collect Rewards =================================
    // Logic
    "DailyReward": {
        "timeout": 30000,
        "next": [
            "CollectDailyReward",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_NavigateDailyMission"
        ]
    },

    "CollectDailyReward": {
        "focus": {
            "Node.PipelineNode.Starting": "一键领取 · 领取日常任务奖励"
        },
        "timeout": 30000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    677,
                    0,
                    214,
                    135
                ],
                "template": "Mission/日常任务_页签.png"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1151,
                    669,
                    1,
                    1
                ]
            }
        },
        "post_wait_freezes": 1000,
        "next": [
            "CollectWeeklyReward",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_NavigateWeeklyMission"
        ]
    },

    "CollectWeeklyReward": {
        "focus": {
            "Node.PipelineNode.Starting": "一键领取 · 领取周常任务奖励"
        },
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    867,
                    0,
                    209,
                    131
                ],
                "template": "Mission/周常任务_页签.png"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1151,
                    669,
                    1,
                    1
                ]
            }
        },
        "post_wait_freezes": 1000,
        // 聚合接力：本任务是「一键领取」的第一环，正常领完周常奖励后交给「领取应对协议」。
        "next": [
            "CountermeasureProtocol"
        ]
    }
}
