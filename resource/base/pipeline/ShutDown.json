{
    // ============================================================
    // ShutDown.json
    // 功能：退出游戏
    // 入口节点：#ShutDown
    // 说明：就是退出游戏。
    // 由 scripts/split_pipeline.py 从 Tasks.json 拆分生成；请勿跨文件重复定义同名节点。
    // 本文件节点数 = 2
    // ============================================================

    "_ExitGame": {
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.leiting.yxhs"
            }
        }
    },

    // ---------- 任务入口：#ShutDown（退出游戏） ----------

    // Shutdown ========================================
    // Entry
    "#ShutDown": {
        "focus": {
            "Node.PipelineNode.Starting": "退出游戏 · 任务开始",
            "Node.PipelineNode.Completed": "退出游戏 · 完成",
            "Node.PipelineNode.Failed": "退出游戏 · 失败"
        },
        "next": [
            "_ExitGame"
        ]
    }
}
