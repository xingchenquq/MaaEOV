{
    // ============================================================
    // Farm.json
    // 功能：清体力
    // 入口节点：#Farm
    // 说明：进行日常的副本刷取，在指定关卡清空全部体力。 [color:red]如目标关卡为危机行动关卡，会一并消耗危机行动调令。[/color]
    // 由 scripts/split_pipeline.py 从 Tasks.json 拆分生成；请勿跨文件重复定义同名节点。
    // 本文件节点数 = 7
    // 依赖 Shared.json 节点数 = 14（示例：ConfirmUseStaminaItem, FarmSelectLevel, _Confirm, _ConfirmSweepResult, _ConfirmReconnect, _False）
    // ============================================================

    // Handle Liminal Zone Overflow Confirmation
    "_ConfirmLiminalZoneOverflow": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    222,
                    225,
                    834,
                    136
                ],
                "expected": [
                    "进行探索",
                    "回收物"
                ]
            }
        },
        "next": [
            "_Confirm"
        ],
        "post_wait_freezes": 1000
    },

    // ---------- 任务入口：#Farm（清体力） ----------

    // Daily Farm ======================================
    // Entry
    "#Farm": {
        "focus": {
            "Node.PipelineNode.Starting": "清体力 · 任务开始",
            "Node.PipelineNode.Completed": "清体力 · 完成",
            "Node.PipelineNode.Failed": "清体力 · 失败"
        },
        "next": [
            "Farm"
        ]
    },

    // Logic
    "Farm": {
        "focus": {
            "Node.PipelineNode.Starting": "清体力 · 正在前往作战准备"
        },
        "timeout": 30000,
        "next": [
            "SelectLevelFromBCR",
            "[JumpBack]_NavigateBCR"
        ]
    },

    "SelectLevelFromBCR": {
        "focus": {
            "Node.PipelineNode.Starting": "清体力 · 选择目标关卡"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1080,
                    607,
                    200,
                    113
                ],
                "expected": [
                    "主线故事"
                ]
            }
        },
        "next": [
            "~LevelNA",
            "~LiminalZoneNA",
            "FarmFromLevel",
            "[JumpBack]FarmSelectLevel"
        ]
    },

    "FarmFromLevel": {
        // timeout 80000：扫荡 gate。[JumpBack] 弹栈（_SweepFromLevel 点击后回本节点续扫 _SweepMax 等）沿用本节点
        // timeout 作为续扫窗口，须覆盖「开弹窗 → 设次数 → 出发」耗时，防默认 20s 提前掐断（同 v1.14.6 根因）。
        "timeout": 80000,
        "focus": {
            "Node.PipelineNode.Starting": "清体力 · 扫荡中"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    804,
                    591,
                    273,
                    129
                ],
                "expected": [
                    "扫荡",
                    "扫汤",
                    "快速完成"
                ]
            }
        },
        "next": [
            "_False",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_ConfirmSweepResult",
            "[JumpBack]_ConfirmLiminalZoneOverflow",
            "[JumpBack]FarmOutOfStamina",
            // 2026-11-13：体力「够但不够这一把」（如 14 < 消耗 20）时游戏不显示恢复倒计时，
            // FarmOutOfStamina 会 miss；本节点读右上体力与「出发 ⚡N」比较后收尾。
            // 必须排在 _SweepFromLevel 之前，否则会又去点一次扫荡然后空转。
            "FarmStaminaShort",
            "[JumpBack]_LevelUp",
            "[JumpBack]_SweepMax",
            "[JumpBack]_SweepFromLevel",
            "[JumpBack]FarmSelectLevel"
        ]
    },

    // Exception
    "FarmOutOfStamina": {
        "focus": {
            "Node.PipelineNode.Starting": "清体力 · 体力不足，准备收尾"
        },
        "timeout": 30000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    452,
                    12,
                    207,
                    125
                ],
                "expected": [
                    "下次恢复时间"
                ]
            }
        },
        // 2026-11-03：体力不足、又没快到期的道具时，先关掉「使用体力道具」弹窗再停，
        // 否则任务结束时界面停在弹窗上，后续任务/手动接手都要先手动点掉。
        // ⚠ 不能直接复用 Shared 的 CloseUseStaminaItem —— 它 next 为空，会弹栈回
        //   FarmFromLevel 重新扫荡，实测进入「扫荡→体力不足→关窗→再扫荡」死循环（120s 超时）。
        "next": [
            "FarmUseExpiringItem",
            "_CloseStaminaAndStop"
        ]
    },

    // 关卡详情页：体力够但不够本次消耗（实测 14 < 消耗 20，游戏不显示恢复倒计时）。
    // 判据在 agent/farm.py 的 FarmStaminaShort：读右上体力 vs 右下「出发 ⚡N」。
    "FarmStaminaShort": {
        "timeout": 20000,
        "focus": {
            "Node.PipelineNode.Starting": "清体力 · 体力不足本次消耗，收尾"
        },
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FarmStaminaShort"
            }
        },
        "next": [
            "_FarmStop"
        ]
    },

    // Optional
    "FarmUseExpiringItem": {
        "focus": {
            "Node.PipelineNode.Starting": "清体力 · 使用即将过期的体力道具"
        },
        "timeout": 30000,
        // "enabled": false,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    539,
                    320,
                    166,
                    128
                ],
                "expected": [
                    "小时"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    628,
                    545,
                    1,
                    1
                ]
            }
        },
        "next": [
            "ConfirmUseStaminaItem"
        ]
    },

    // 体力不足收尾专用：关掉弹窗后直接停止任务（区别于通用 CloseUseStaminaItem 的弹栈续跑）。
    "_CloseStaminaAndStop": {
        "focus": {
            "Node.PipelineNode.Starting": "清体力 · 关闭体力弹窗"
        },
        "timeout": 15000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    452,
                    12,
                    207,
                    125
                ],
                "expected": [
                    "下次恢复时间"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1080,
                    327,
                    1,
                    1
                ]
            }
        },
        "post_wait_freezes": 1000,
        "next": [
            "_FarmStop"
        ]
    },

    // 体力不足收尾（2026-11-07 改）：
    // 原来 `_CloseStaminaAndStop` 关掉弹窗后直接 `_StopTask` → `_HaltTask`，任务停在关卡界面，
    // 日志记「任务完成（中途中止）」，下一个任务要 6 个节点 / 10 秒才摸回主界面。
    // 现在保留「记录任务中止」留痕，但先回主界面再收工。
    // ⚠ 必须用 `~TaskExitStop`（到家焊死 StopTask）而非 `~TaskExit`：本节点是从
    //   `[JumpBack]FarmOutOfStamina` 调起来的，收尾若"自然结束"会弹回 Farm 的 next 列表，
    //   而体力读数为 0 仍能命中 FarmOutOfStamina → 26 秒一轮死循环（实测）。
    "_FarmStop": {
        "focus": {
            "Node.PipelineNode.Starting": "清体力 · 已停止（体力耗尽）"
        },
        "timeout": 30000,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "记录任务中止"
            }
        },
        "next": [
            "~TaskExitStop"
        ]
    }
}
