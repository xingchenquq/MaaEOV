                    1,
                    1
                ]
            }
        },
        "post_wait_freezes": 1000,
        "next": [
            "RitualAgent1",
            "RitualAgent2",
            "RitualAgent3",
            "RitualAgent4",
            "RitualCompleted_NoKey2Agent",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
