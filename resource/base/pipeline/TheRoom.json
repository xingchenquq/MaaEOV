    // 探员页：按卡位顺序选第一个「可开始仪式」的探员。
    // 2026-11-02 实测：休息中的卡按钮不是「开始仪式」，OCR 匹配不到会自动落位下一张，
    // 因此「只认第一张卡」和「有人休息就整单结束」两个问题一并解决。
    // 卡位按钮坐标（1280x720 实测）：卡1 (209,546) 卡2 (509,546) 卡3 (808,550) 卡4 (1086,550)。
    // 卡4 右半被右侧资源图例条遮挡，OCR 只读得出「开始仪」，故用前缀匹配。
    // 四张卡都不可用时，落到 RitualCompleted_NoKey2Agent（OCR「加速」）→ 按选项结束或花钥匙加速。
    "RitualRewardSelect": {
        "timeout": 30000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    187,
                    0,
                    197,
                    129
                ],
                "expected": [
                    "探员需求"
                ]
            }
        },
        "next": [
            "RitualAgent1",
            "RitualAgent2",
            "RitualAgent3",
            "RitualAgent4",
            "RitualCompleted_NoKey2Agent",
            "[JumpBack]Key2Agent",
            "[JumpBack]_ServerMaintenance",
            "[JumpBack]_ConfirmReconnect",
            "[JumpBack]_NavigateRitualSelectAgent"
        ]
    },

    // ---------- 「解读仪式偏好」4 个筛选位 ----------
    // 2026-11-02 实测：探员页右侧竖条**是可点的需求筛选器**（点击后左侧探员列表整批替换、
    // 「必要物品」图标同步变化）。此前误判为"纯装饰"，实为当时筛完结果恰好相同、画面无变化。
    //
    // 竖条 4 个图标自上而下的语义（用户确认，与 interface「解读仪式偏好」case 同序）：
    //   ① 行动资金        (1185, 240)
