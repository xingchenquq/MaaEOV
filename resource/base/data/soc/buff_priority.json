    // ============================================================
    // buff_priority.json — 认知海域「灵感」选择优先级（单一数据源）
    //
    // 两档策略：
    //   mode = "left"    → 原样行为：全局灵感点最左一张、局内灵感点左卡。不读卡名，零失败风险。
    //   （无 mode 字段）  → 按本表打分：先 known 精确卡名，再 categories 关键词，最后 default 中性分。
    //
    // ⚠️ 权重来源：目前**没有战斗失败样本**，分数按常识填，属待校准值。
    //    等有失败截图（站不住 / 打超时 / 被秒）再按实际死因调整。
    //
    // 卡面模板匹配实测只有 0.18~0.53（背景动效干扰），**不可用于判卡**；
    // 唯一可靠信号是 OCR 读出的卡片标题文字。
    // ============================================================
    "version": 2,
    "default_profile": "p1",
    "profiles": {
        // ---------------- 配置一：原样（不读卡名） ----------------
