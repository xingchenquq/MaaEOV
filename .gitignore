# =====================
# MaaEOV .gitignore
# 只提交源码与素材（resource/agent/config/interface.json/README/LICENSE 等），
# 排除发布版二进制运行时与调试产物。
# =====================

# ---- 发布版二进制 / 运行时（非源码） ----
*.exe
*.dll
*.pdb
*.node
*.pyd
*.so
*.bak

# 内嵌 Python 解释器（随发布包分发，非项目源码）
/python/

# Agent 运行时二进制
/MaaAgentBinary/

# GUI 运行时附属文件
/SukiUI.xml
/MFAUpdater.runtimeconfig.json

# ---- 调试 / 日志 / 缓存 ----
/debug/
/logs/
.nicegui/
__pycache__/
*.pyc

# ---- 本地工作区配置 / 记忆（不入库） ----
/.workbuddy/

# ---- 本地临时脚本（含本机绝对路径 / 个人模拟器录制，不纳入仓库） ----
/scripts/check_templates.py
/scripts/crop_templates.py
/scripts/fix_template_paths.py
/scripts/parse_mmor.py
/scripts/validate_pipeline.py
/scripts/check_roi.py
/scripts/check_versions.py
/scripts/grid_view.py
/scripts/loadres.py
/scripts/loadres2.py
/scripts/post_upgrade_tidy.py
/scripts/fix_soc_dive_flow.py
/scripts/fix_soc_entry_nav.py
/scripts/fix_soc_ocr_variants.py
/scripts/fix_soc_templates.py

# ---- 原始素材截图（裁模板用的源图，不随发布包分发） ----
/resource/base/image/SeaOfCognition/raw/

# ---- GUI 升级引入的运行时目录 / 构建产物 / 回滚备份 ----
/libs/
/runtimes/
/plugins/
/.mfa_build/
/backup/
/resource/mfa_layout.json
/DependencySetup_*.bat

# ---- 发布完整运行包构建脚本 / 产物（本机专用，不入库） ----
/dist/
/package_full.py
/package_full_log.txt
/verify_zip.py
/build_resource_zip.py
/build_resource_log.txt
/MaaEOV-resource.zip

# ---- 本地设备 / 运行期配置（每台机器不同，不入库） ----
/config/maa_pi_config.json
config/instances/*.json

# ---- 操作系统 / 编辑器 ----
.DS_Store
Thumbs.db
*.swp
